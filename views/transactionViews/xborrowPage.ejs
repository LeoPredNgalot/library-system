<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Borrow — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:      #07111d;
      --bg-sidebar:   #0a1828;
      --bg-main:      #080f1a;
      --bg-card:      #0d1e30;
      --bg-input:     #091522;
      --border:       rgba(255,255,255,0.06);
      --border-light: rgba(255,255,255,0.09);
      --accent:       #22d3ee;
      --accent-dim:   rgba(34,211,238,0.12);
      --accent-glow:  rgba(34,211,238,0.18);
      --text-primary: #ddeeff;
      --text-secondary:#7a9bb8;
      --text-muted:   #3d5a73;
      --sidebar-w:    220px;
      --topbar-h:     58px;
      --radius:       12px;
    }

    html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: var(--bg-deep); color: var(--text-primary); overflow: hidden; }

    /* ══ SIDEBAR ══ */
    .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-w); background: var(--bg-sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; z-index: 50; }
    .sidebar-logo { display: flex; align-items: center; gap: 10px; padding: 20px 18px 18px; border-bottom: 1px solid var(--border); }
    .logo-icon { width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(135deg,#0e7490,#22d3ee); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(34,211,238,0.22); flex-shrink: 0; }
    .logo-name { font-size: 14px; font-weight: 700; color: var(--text-primary); }
    .logo-sub  { font-size: 10px; color: var(--text-muted); letter-spacing: 0.06em; text-transform: uppercase; margin-top: 1px; }
    .sidebar-nav { flex: 1; overflow-y: auto; padding: 14px 10px; }
    .sidebar-nav::-webkit-scrollbar { width: 3px; }
    .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }
    .nav-label { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); padding: 6px 8px 4px; margin-top: 8px; }
    .nav-link { display: flex; align-items: center; gap: 9px; padding: 8px 10px; border-radius: 8px; font-size: 13.5px; font-weight: 500; color: var(--text-secondary); text-decoration: none; cursor: pointer; transition: background 0.15s, color 0.15s; user-select: none; }
    .nav-link:hover { background: rgba(34,211,238,0.06); color: var(--text-primary); }
    .nav-link.active { background: var(--accent-dim); color: var(--accent); }
    .nav-link.active svg { stroke: var(--accent); }
    .nav-link svg { flex-shrink: 0; opacity: 0.75; }
    .nav-link.active svg { opacity: 1; }
    .nav-chevron { margin-left: auto; transition: transform 0.2s; opacity: 0.5; }
    .nav-submenu { overflow: hidden; max-height: 0; transition: max-height 0.25s ease; }
    .nav-submenu.open { max-height: 120px; }
    .nav-submenu .nav-link { padding-left: 30px; font-size: 13px; }
    .sidebar-footer { border-top: 1px solid var(--border); padding: 12px 10px; position: relative; }
    .profile-btn { width: 100%; display: flex; align-items: center; gap: 9px; background: none; border: none; cursor: pointer; padding: 8px 10px; border-radius: 8px; transition: background 0.15s; text-align: left; }
    .profile-btn:hover { background: rgba(255,255,255,0.04); }
    .avatar { width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg,#0e7490,#22d3ee); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: white; flex-shrink: 0; }
    .profile-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .profile-role { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
    .profile-chevron { margin-left: auto; color: var(--text-muted); transition: transform 0.2s; }
    .profile-panel { position: absolute; bottom: calc(100% + 6px); left: 10px; right: 10px; background: #0f2035; border: 1px solid var(--border-light); border-radius: 10px; overflow: hidden; opacity: 0; pointer-events: none; transform: translateY(6px); transition: opacity 0.18s, transform 0.18s; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
    .profile-panel.open { opacity: 1; pointer-events: all; transform: translateY(0); }
    .profile-panel-header { padding: 12px 14px; border-bottom: 1px solid var(--border); }
    .profile-panel-header p { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .profile-panel-header small { font-size: 11px; color: var(--text-muted); }
    .panel-item { display: flex; align-items: center; gap: 8px; padding: 9px 14px; font-size: 13px; color: var(--text-secondary); text-decoration: none; transition: background 0.12s, color 0.12s; }
    .panel-item:hover { background: rgba(255,255,255,0.04); color: var(--text-primary); }
    .panel-item.danger { color: #f87171; }
    .panel-item.danger:hover { background: rgba(248,113,113,0.08); }

    /* ══ MAIN ══ */
    .main { margin-left: var(--sidebar-w); height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
    .topbar { height: var(--topbar-h); display: flex; align-items: center; padding: 0 28px; border-bottom: 1px solid var(--border); background: var(--bg-main); flex-shrink: 0; }
    .topbar-left { display: flex; flex-direction: column; }
    .topbar-eyebrow { font-size: 10.5px; color: var(--text-muted); letter-spacing: 0.07em; text-transform: uppercase; }
    .topbar-title { font-size: 17px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }

    .page-body { flex: 1; overflow-y: auto; padding: 32px 28px; background: var(--bg-main); display: flex; align-items: flex-start; justify-content: center; }
    .page-body::-webkit-scrollbar { width: 4px; }
    .page-body::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }

    /* ══ FORM CARD ══ */
    .form-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      width: 100%;
      max-width: 480px;
      overflow: hidden;
      animation: fadeUp 0.35s ease both;
    }
    @keyframes fadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

    .card-head { padding: 20px 24px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .card-head-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .card-head-title { font-size: 15px; font-weight: 700; color: var(--text-primary); }
    .card-head-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

    .card-body { padding: 24px; display: flex; flex-direction: column; gap: 18px; }

    /* fields */
    .field-label { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 7px; display: block; }
    .field-label span { color: var(--accent); }
    .field-wrap { position: relative; }
    .field-wrap svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
    .field-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px 10px 34px;
      font-size: 13px;
      color: var(--text-primary);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .field-input::placeholder { color: var(--text-muted); }
    .field-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

    /* date input calendar icon color fix */
    .field-input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(0.5); cursor: pointer; }

    .card-divider { height: 1px; background: var(--border); }

    /* buttons */
    .card-footer { padding: 18px 24px; display: flex; gap: 10px; }
    .btn-record {
      flex: 1;
      display: flex; align-items: center; justify-content: center; gap: 7px;
      padding: 10px 18px;
      border-radius: 8px;
      background: linear-gradient(135deg,#0e7490,#22d3ee);
      border: none;
      color: white;
      font-size: 13.5px;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.12s;
      box-shadow: 0 2px 12px rgba(34,211,238,0.2);
    }
    .btn-record:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-record:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .btn-cancel {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      padding: 10px 18px;
      border-radius: 8px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-cancel:hover { border-color: var(--border-light); color: var(--text-primary); }

    .required-note { text-align: center; font-size: 11.5px; color: var(--text-muted); padding: 0 24px 18px; }
    .required-note span { color: var(--accent); }

    /* toast */
    .toast { position: fixed; bottom: 24px; right: 24px; background: #0f2035; border: 1px solid var(--border-light); border-radius: 10px; padding: 12px 18px; font-size: 13px; color: var(--text-primary); box-shadow: 0 8px 32px rgba(0,0,0,0.4); z-index: 200; animation: toastIn 0.25s ease; max-width: 360px; line-height: 1.5; }
    .toast.hidden { display: none; }
    .toast.error   { border-color: rgba(248,113,113,0.3); background: #1a0f0f; }
    .toast.success { border-color: rgba(52,211,153,0.3); }
    @keyframes toastIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
  </style>
</head>
<body>

<!-- ══ SIDEBAR ══ -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
    </div>
    <div>
      <div class="logo-name">Voctech Library</div>
      <div class="logo-sub">Management System</div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-label">Main</div>
    <a href="/librarian/admin/homepage" class="nav-link">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Dashboard
    </a>
    <a href="/book/get-all-books" class="nav-link">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      Books
    </a>
    <a href="/user/view-all-users" class="nav-link">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      Students
    </a>
    <a href="/librarian/view-all-librarians" class="nav-link">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Librarians
    </a>
    <div class="nav-label">Transactions</div>
    <a class="nav-link" id="transBtn" onclick="toggleTrans(this);return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Transactions
      <svg class="nav-chevron" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </a>
    <div class="nav-submenu open" id="transSubmenu">
      <a href="/transaction/borrow" class="nav-link active">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        Borrow
      </a>
      <a href="/transaction/view-all-borrow-records" class="nav-link">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path stroke-linecap="round" d="M3 9h18M9 21V9"/></svg>
        Records
      </a>
      <a href="/transaction/reservation" class="nav-link">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
        Reservations
      </a>
    </div>
    <div class="nav-label">Reports</div>
    <a href="/report" class="nav-link">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      Reports
    </a>
  </nav>
  <div class="sidebar-footer" id="profileWrap">
    <button class="profile-btn" onclick="toggleProfile()">
      <div class="avatar">AD</div>
      <div><div class="profile-name">Administrator</div><div class="profile-role">Admin</div></div>
      <svg class="profile-chevron" id="profileChevron" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="profile-panel" id="profilePanel">
      <div class="profile-panel-header"><p>Administrator</p><small>Admin Account</small></div>
      <a class="panel-item danger" href="/librarian/logout">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Sign Out
      </a>
    </div>
  </div>
</aside>

<!-- ══ MAIN ══ -->
<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <span class="topbar-eyebrow">Voctech Library · Transactions</span>
      <span class="topbar-title">Record Borrow</span>
    </div>
  </div>

  <div class="page-body">
    <div class="form-card">

      <!-- Card Header -->
      <div class="card-head">
        <div style="display:flex;align-items:center;gap:12px;">
          <div class="card-head-icon">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
          </div>
          <div>
            <div class="card-head-title">Record Borrow</div>
            <div class="card-head-sub">Fill in the details to log a book borrowing.</div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <form id="form" enctype="multipart/form-data">
        <div class="card-body">

          <!-- Student ID -->
          <div>
            <label class="field-label" for="studentId">Student ID <span>*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              <input type="text" id="studentId" name="studentId" required placeholder="e.g. 2024-00001" class="field-input" />
            </div>
          </div>

          <!-- Book Copy ID -->
          <div>
            <label class="field-label" for="bookCopyId">Book Copy ID <span>*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
              <input type="text" id="bookCopyId" name="bookCopyId" required placeholder="e.g. COPY-00123" class="field-input" />
            </div>
          </div>

          <!-- Due Date -->
          <div>
            <label class="field-label" for="dueDate">Due Date <span>*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <input
                type="date"
                id="dueDate"
                name="dueDate"
                required
                min="<%= new Date().toISOString().split('T')[0] %>"
                class="field-input"
              />
            </div>
          </div>

        </div>

        <div class="card-divider"></div>

        <div class="card-footer">
          <button type="submit" id="recordBtn" class="btn-record">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            Record Borrow
          </button>
          <button type="button" onclick="window.history.back()" class="btn-cancel">Cancel</button>
        </div>

        <p class="required-note"><span>*</span> Required fields</p>
      </form>

    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast hidden" id="notificationToast"></div>

<script>
  // ── Sidebar ──
  function toggleTrans(btn) {
    const sub = document.getElementById('transSubmenu');
    sub.classList.toggle('open');
    btn.querySelector('.nav-chevron').style.transform = sub.classList.contains('open') ? 'rotate(180deg)' : '';
  }
  // Keep submenu open on load since Borrow is active
  document.getElementById('transBtn').querySelector('.nav-chevron').style.transform = 'rotate(180deg)';

  function toggleProfile() {
    const panel   = document.getElementById('profilePanel');
    const chevron = document.getElementById('profileChevron');
    const isOpen  = panel.classList.toggle('open');
    chevron.style.transform = isOpen ? 'rotate(180deg)' : '';
  }
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#profileWrap')) {
      document.getElementById('profilePanel').classList.remove('open');
      document.getElementById('profileChevron').style.transform = '';
    }
  });

  // ── Toast ──
  function showToast(msg, duration = 4000) {
    const t = document.getElementById('notificationToast');
    t.textContent = msg;
    t.classList.remove('hidden', 'error', 'success');
    if (msg.startsWith('✗')) t.classList.add('error');
    else if (msg.startsWith('✓')) t.classList.add('success');
    clearTimeout(t._timer);
    t._timer = setTimeout(() => t.classList.add('hidden'), duration);
  }
</script>

<script src="/transactionPagesScript/borrowPage.js"></script>
</body>
</html>

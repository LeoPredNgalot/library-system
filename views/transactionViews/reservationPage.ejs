<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reservations — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/togglebutton/theme.css" />
  <link rel="stylesheet" href="../styles/transactionPagesStyleFolder/reservationPage.css">
  <script>
  // Anti-flash on load
  (function(){
    if(localStorage.getItem('theme') === 'dark'){
      document.documentElement.classList.add('dark');
    }
  })();

  // Listen for toggle from parent dashboard
  window.addEventListener('storage', function(e){
    if(e.key === 'theme'){
      if(e.newValue === 'dark'){
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
  });
</script>
  <script>
    if (new URLSearchParams(window.location.search).get('embed') === 'true') {
      document.documentElement.classList.add('embedded');
    }
  </script>
  <style>
    html.embedded .sidebar { display: none !important; }
    html.embedded .main    { margin-left: 0 !important; }
  </style>
</head>
<body>



<!-- MAIN -->
<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <span class="topbar-title">Reservations</span>
    </div>
    
  </div>

  <div class="page-body">

     <div style="display:flex; justify-content:flex-end; margin-bottom:20px;">
      <button type="button" class="topbar-btn" id="openModalBtn">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Reservation
      </button>
    </div>
    <div class="table-card">

      <!-- ══ FILTER BAR ══ -->
      <form method="GET" action="/transaction/reservation">
        <div class="filter-bar">

          <div class="filter-search">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
            <input
              type="text"
              name="search"
              id="searchInput"
              class="filter-input"
              placeholder="Search student / book title…"
              value="<%= filters?.search || '' %>"
            />
          </div>

          <div class="select-wrap">
            <select name="status" id="statusFilter" class="filter-select">
              <option value="all"       <%= filters?.status === 'all'       ? 'selected' : '' %>>All Status</option>
              <option value="waiting"   <%= filters?.status === 'waiting'   ? 'selected' : '' %>>Waiting</option>
              <option value="pending"   <%= filters?.status === 'pending'   ? 'selected' : '' %>>Pending</option>
              <option value="fulfilled" <%= filters?.status === 'fulfilled' ? 'selected' : '' %>>Fulfilled</option>
              <option value="expired"   <%= filters?.status === 'expired'   ? 'selected' : '' %>>Expired</option>
              <option value="cancelled" <%= filters?.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>

          <div class="select-wrap">
            <select name="grade" id="gradeFilter" class="filter-select">
              <option value=""   <%= !filters?.grade           ? 'selected' : '' %>>All Grades</option>
              <option value="11" <%= filters?.grade === '11'   ? 'selected' : '' %>>Grade 11</option>
              <option value="12" <%= filters?.grade === '12'   ? 'selected' : '' %>>Grade 12</option>
            </select>
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>

          <button type="submit" class="filter-btn">Apply</button>

        </div>
      </form>

      <!-- Table -->
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Book Title</th>
              <th>Student ID</th>
              <th>Student Name</th>
              <th>Copy ID</th>
              <th>Status</th>
              <th>Reserved Date</th>
              <th>Expire Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (!reservations || reservations.length === 0) { %>
              <tr class="no-data-row"><td colspan="8">No reservations found.</td></tr>
            <% } else { %>
              <% reservations.forEach(r => {
                const resDate = r.reserved_date ? new Date(r.reserved_date).toLocaleDateString('en-CA', { timeZone: 'UTC' }) : '—';
                const expDate = r.expire_date   ? new Date(r.expire_date).toLocaleDateString('en-CA',   { timeZone: 'UTC' }) : '—';
                const st = (r.status || 'waiting').toLowerCase();
                const studentName = r.studentName || r.student_name || '—';
                const bookTitle   = r.bookTitle   || r.book_title   || '—';
                const studentId   = r.studentID   || r.student_id   || '—';
              %>
              <tr>
                <td><span class="cell-title"><%= bookTitle %></span></td>
                <td><span class="cell-mono"><%= studentId %></span></td>
                <td><%= studentName %></td>
                <td>
                  <% if (r.copyID || r.book_copy_id) { %>
                    <span class="cell-mono"><%= r.copyID || r.book_copy_id %></span>
                  <% } else { %>
                    <span class="cell-unassigned">Not assigned</span>
                  <% } %>
                </td>
                <td><span class="badge badge-<%= st %>"><%= st %></span></td>
                <td><%= resDate %></td>
                <td><%= expDate %></td>
                <td>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    <% if (st === 'waiting' || st === 'pending') { %>
                      <button type="button" class="tbl-btn cancel cancelBtn" data-id="<%= r.reservation_id %>">
                        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        Cancel
                      </button>
                    <% } %>
                    <% if (st === 'pending') { %>
                      <button type="button" class="tbl-btn fulfill fulfillBtn"
                        data-id="<%= r.reservation_id %>"
                        data-student="<%= studentName %>"
                        data-student-id="<%= studentId %>"
                        data-book="<%= bookTitle %>">
                        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Fulfill
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Footer count -->
    

      <!-- ══ PAGINATION ══ -->
      <% if (pagination ) { %>
      <div class="pagination">
        <div class="page-info">
          Showing <span><%= ((pagination.currentPage - 1) * pagination.pageSize) + 1 %>–<%= Math.min(pagination.currentPage * pagination.pageSize, pagination.total) %></span>
          of <span><%= pagination.total %></span> results
        </div>

        <div class="pg-btns">

          <!-- PREV -->
          <button class="pg-btn" <%= !pagination.hasPrev ? 'disabled' : '' %>
            onclick="location.href='/transaction/reservation?page=<%= pagination.currentPage - 1 %>&search=<%= encodeURIComponent(filters.search || '') %>&status=<%= encodeURIComponent(filters.status || 'all') %>&grade=<%= encodeURIComponent(filters.grade || '') %>'">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
            Prev
          </button>

          <!-- PAGE NUMBERS -->
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <a
              class="pg-btn <%= i === pagination.currentPage ? 'active' : '' %>"
              href="/transaction/reservation?page=<%= i %>&search=<%= encodeURIComponent(filters.search || '') %>&status=<%= encodeURIComponent(filters.status || 'all') %>&grade=<%= encodeURIComponent(filters.grade || '') %>"
            ><%= i %></a>
          <% } %>

          <!-- NEXT -->
          <button class="pg-btn" <%= !pagination.hasNext ? 'disabled' : '' %>
            onclick="location.href='/transaction/reservation?page=<%= pagination.currentPage + 1 %>&search=<%= encodeURIComponent(filters.search || '') %>&status=<%= encodeURIComponent(filters.status || 'all') %>&grade=<%= encodeURIComponent(filters.grade || '') %>'">
            Next
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>

        </div>
      </div>
      <% } %>

    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast hidden" id="notificationToast"></div>

<!-- ══ ADD RESERVATION MODAL ══ -->
<div class="modal-overlay hidden" id="reservePanel">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Reservation</div>
        <div class="modal-head-sub">Reserve a book for a student.</div>
      </div>
      <button type="button" class="btn-close" id="closeModalBtn">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="reserveForm">
      <div class="modal-body">
        <div>
          <label class="field-label">Student <span>*</span></label>
          <div class="ac-wrap">
            <div class="field-wrap" id="studentInputWrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              <input type="text" id="studentSearch" class="modal-input" placeholder="Type student ID or name…" autocomplete="off" />
              <div class="ac-selected hidden" id="studentSelected">
                <span id="studentSelectedText"></span>
                <button type="button" class="ac-clear" id="clearStudent">✕</button>
              </div>
            </div>
            <ul class="ac-dropdown hidden" id="studentDropdown"></ul>
            <input type="hidden" id="selectedStudentId" name="studentId" />
          </div>
        </div>
        <div>
          <label class="field-label">Book <span>*</span></label>
          <div class="ac-wrap">
            <div class="field-wrap" id="bookInputWrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
              <input type="text" id="bookSearch" class="modal-input" placeholder="Type book title…" autocomplete="off" />
              <div class="ac-selected hidden" id="bookSelected">
                <span id="bookSelectedText"></span>
                <button type="button" class="ac-clear" id="clearBook">✕</button>
              </div>
            </div>
            <ul class="ac-dropdown hidden" id="bookDropdown"></ul>
            <input type="hidden" id="selectedBookId" name="bookId" />
          </div>
        </div>
        <div class="error-notice" id="errorNotice"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="clearFormBtn">Clear</button>
        <button type="submit" class="btn-primary" id="reserveBtn">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
          Reserve
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ══ FULFILL BORROW MODAL ══ -->
<div class="modal-overlay hidden" id="fulfillPanel">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon" style="background:rgba(52,211,153,0.12);">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#34d399" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Fulfill Reservation</div>
        <div class="modal-head-sub">Create a borrow record for this reservation.</div>
      </div>
      <button type="button" class="btn-close" id="closeFulfillBtn">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="info-row">
        <div class="info-box">
          <div class="info-box-label">Student</div>
          <div class="info-box-value" id="fulfillStudentName">—</div>
        </div>
        <div class="info-box">
          <div class="info-box-label">Student ID</div>
          <div class="info-box-value mono" id="fulfillStudentId">—</div>
        </div>
      </div>
      <div class="info-box" style="margin-top:-4px;">
        <div class="info-box-label">Book Title</div>
        <div class="info-box-value" id="fulfillBookTitle">—</div>
      </div>
      <div style="background:var(--accent-dim);border:1px solid rgba(34,211,238,0.18);border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:8px;">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span style="font-size:12px;color:var(--text-secondary);line-height:1.5;">The system will automatically assign the first available copy of this book.</span>
      </div>
      <div>
        <label class="field-label" for="fulfillDueDate">Due Date <span>*</span></label>
        <div class="field-wrap">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <input type="date" id="fulfillDueDate" class="modal-input" />
        </div>
      </div>
      <div class="error-notice" id="fulfillErrorNotice"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-secondary" id="cancelFulfillBtn">Cancel</button>
      <button type="button" class="btn-fulfill-confirm" id="confirmFulfillBtn">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Confirm &amp; Borrow
      </button>
    </div>
  </div>
</div>

<script src="../../transactionPagesScript/reservationPage2.js"></script>
</body>
</html>
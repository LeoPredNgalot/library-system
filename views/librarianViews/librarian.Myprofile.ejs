<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
 <link rel="stylesheet" href="/styles/librarianPagesStyleFolder/librarian.Myprofile.css" />
 <style>
    
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-left">
    <span class="topbar-eyebrow">Voctech Library · Account</span>
    <span class="topbar-title">My Profile</span>
  </div>
</div>

<div class="page-body">

  <!-- ── Profile Header — mirrors book-header-card ── -->
  <div class="profile-header-card">

    <!-- Avatar — mirrors book-cover -->
    <div class="profile-avatar-block">
      <div class="avatar-circle">
        <%= librarian.first_name.charAt(0).toUpperCase() %><%= librarian.last_name.charAt(0).toUpperCase() %>
      </div>
      <span class="avatar-caption"><%= librarian.user_name %></span>
    </div>

    <!-- Info — mirrors book-info -->
    <div class="profile-info">

      <!-- Name + role — mirrors book-title-block -->
      <div class="profile-title-block">
        <h1><%= librarian.first_name %> <%= librarian.last_name %></h1>
        <span class="role-badge"><%= librarian.role %></span>
      </div>

      <div class="profile-divider"></div>

      <!-- Read-only fields — mirrors book-meta 2-col grid -->
      <dl class="profile-meta">
        <div>
          <dt>First Name</dt>
          <dd><%= librarian.first_name %></dd>
        </div>
        <div>
          <dt>Last Name</dt>
          <dd><%= librarian.last_name %></dd>
        </div>
        <div>
          <dt>Username</dt>
          <dd class="mono"><%= librarian.user_name %></dd>
        </div>
        <div>
          <dt>Date Registered</dt>
          <dd class="mono"><%= librarian.date_registered %></dd>
        </div>
      </dl>

    </div>
  </div>

  <!-- ── Edit Form — mirrors copies-card ── -->
  <div class="form-card">
    <div class="form-card-header">
      <h2>Edit Profile</h2>
    </div>

    <form id="form" enctype="multipart/form-data" data-librarian-id="<%= librarian.id %>">
      <div class="form-body">

        <!-- Email + Phone side by side -->
        <div class="field-row">
          <div class="field">
            <label class="field-label" for="email">Email <span>*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <input type="email" id="email" name="email" class="field-input"
                value="<%= librarian.email %>" required />
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="contactNumber">Phone Number</label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <input type="tel" id="contactNumber" name="contact_number" class="field-input"
                value="<%= librarian.contact_number %>" />
            </div>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Password full width -->
        <div class="field">
          <label class="field-label" for="password">New Password</label>
          <div class="field-wrap">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"/></svg>
            <input type="password" id="password" name="password" class="field-input"
              placeholder="Leave blank to keep current password" />
          </div>
          <span class="field-hint">Only fill this in if you want to change your password.</span>
        </div>

      </div>

      <div class="form-footer">
        
        <button type="submit" class="btn-update">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Update Profile
        </button>
      </div>
    </form>
  </div>

  <div class="page-body-end"></div>
</div>

<script src="/librarianPagesScripts/myProfile.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Librarians — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="/styles/librarianPagesStyleFolder/viewAllLIbrarians.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  
  <script>
    if (new URLSearchParams(window.location.search).get('embed') === 'true') {
      document.documentElement.classList.add('embedded');
    }
  </script>
  <style>
    html.embedded .sidebar { display: none !important; }
    html.embedded .main    { margin-left: 0 !important; }
  </style>
</head>



<body>

<!-- ══ AUTOFILL TRAP ══ -->
<div style="display:none;" aria-hidden="true">
  <input type="text" name="fake_username_trap" tabindex="-1" autocomplete="username" />
  <input type="password" name="fake_password_trap" tabindex="-1" autocomplete="current-password" />
</div>



<!-- ══ MAIN ══ -->
<div class="main">
  <div class="topbar">
    <div class="topbar-left">
     
      <span class="topbar-title">Librarians</span>
    </div>
    <button type="button" class="topbar-btn" id="openAddModal">
      <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Librarian
    </button>
  </div>

  <div class="page-body">
    <div class="table-card">
      <div class="filter-bar">
        <div class="filter-search">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          <input type="search" id="libSearchInput" class="filter-input"
            placeholder="Search by name, username, email…"
            autocomplete="off"
            name="lib-search-field" />
        </div>
        <button class="btn-search" id="libSearchBtn">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          Search
        </button>
      </div>

      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Username</th>
              <th>Name</th>
              <th>Email</th>
              <th>Contact Number</th>
              <th>Date Registered</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="libTableBody">
            <% if (librarians.length === 0) { %>
              <tr class="no-data-row"><td colspan="6">No librarians found.</td></tr>
            <% } %>
            <% librarians.forEach((librarian, idx) => { %>
              <%
                const initials = ((librarian.first_name || '').charAt(0) + (librarian.last_name || '').charAt(0)).toUpperCase() || 'LB';
                const avClass = 'av-' + (idx % 5);
                const fullName = (librarian.first_name || '') + ' ' + (librarian.last_name || '');
                const dateReg = librarian.date_registered
                  ? new Date(librarian.date_registered).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })
                  : '—';
              %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div class="lib-avatar <%= avClass %>"><%= initials %></div>
                    <span class="lib-username"><%= librarian.user_name %></span>
                  </div>
                </td>
                <td><span class="lib-name"><%= fullName.trim() || '—' %></span></td>
                <td><span class="lib-email"><%= librarian.email || '—' %></span></td>
                <td><span class="lib-contact"><%= librarian.contact_number || '—' %></span></td>
                <td><span class="lib-date"><%= dateReg %></span></td>
                <td>
                  <div class="actions-cell">
                    <!-- ✅ CHANGE: added data-dateregistered -->
                    <button type="button" class="action-btn edit editBtn" title="Edit"
                      data-id="<%= librarian.id %>"
                      data-username="<%= librarian.user_name %>"
                      data-email="<%= librarian.email %>"
                      data-firstname="<%= librarian.first_name %>"
                      data-lastname="<%= librarian.last_name %>"
                      data-contact="<%= librarian.contact_number %>"
                      data-dateregistered="<%= dateReg %>">
                      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    <button type="button" class="action-btn del deleteBtn" title="Delete"
                      data-librarian-id="<%= librarian.id %>">
                      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                    <button type="button" class="action-btn reset resetBtn" title="Reset Password"
                      data-librarian-id="<%= librarian.id %>">
                      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="table-footer">
        <p class="table-footer-text">Showing <span><%= librarians.length %></span> librarian<%= librarians.length !== 1 ? 's' : '' %></p>
      </div>
    </div>
  </div>
</div>

<!-- ══ ADD LIBRARIAN MODAL ══ -->
<div class="modal-overlay hidden" id="addModal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon info">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Librarian Registration</div>
        <div class="modal-head-sub">Fill in the details to register a librarian.</div>
      </div>
      <button type="button" class="btn-close" id="closeAddModal">
        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="addForm" autocomplete="off">
      <div style="padding:18px 20px;">
        <div class="form-grid">
          <div class="col-full">
            <label class="field-label" for="addUsername">Username <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="addUsername" name="librarianUserName" required class="modal-input" placeholder="e.g. librarian_juan" autocomplete="off" />
            </div>
          </div>
          <div>
            <label class="field-label" for="addFirstName">First Name <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="addFirstName" name="librarianFirstName" required class="modal-input" placeholder="Juan" autocomplete="off" />
            </div>
          </div>
          <div>
            <label class="field-label" for="addLastName">Last Name <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="addLastName" name="librarianLastName" required class="modal-input" placeholder="Dela Cruz" autocomplete="off" />
            </div>
          </div>
          <div class="col-full">
            <label class="field-label" for="addPassword">Password <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"/></svg>
              <input type="password" id="addPassword" name="librarianPassword" required class="modal-input" placeholder="Enter secure password" autocomplete="new-password" />
            </div>
          </div>
          <div class="col-full">
            <label class="field-label" for="addEmail">Email Address <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <input type="email" id="addEmail" name="librarianEmail" required class="modal-input" placeholder="librarian@school.edu.ph" autocomplete="off" />
            </div>
          </div>
          <div class="col-full">
            <label class="field-label" for="addContact">Contact Number <span class="opt">(optional)</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <input type="text" id="addContact" name="librarianContactNumber" class="modal-input" placeholder="+63 9XX XXX XXXX" autocomplete="off" />
            </div>
          </div>
          <div class="col-full">
            <label class="field-label" for="addDateRegistered">Date Registered</label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <input type="text" id="addDateRegistered" name="librarianDateRegistered" class="modal-input" readonly tabindex="-1" />
            </div>
          </div>
        </div>
      </div>
      <div class="form-divider"></div>
      <div class="modal-footer-btns">
        <button type="button" class="btn-secondary" id="cancelAddModal">Cancel</button>
        <button type="submit" class="btn-primary">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Register
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ══ EDIT MODAL ══ -->
<div class="modal-overlay hidden" id="editModal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon warning">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#fbbf24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Edit Librarian</div>
        <div class="modal-head-sub">Update librarian information</div>
      </div>
      <button type="button" class="btn-close" id="cancelEditTop">
        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="editForm" autocomplete="off">
      <input type="hidden" id="editId" />
      <div style="padding:18px 20px;">
        <div class="form-grid">
          <div class="col-full">
            <label class="field-label" for="editUsername">Username <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="editUsername" name="librarianUserName" required class="modal-input" placeholder="e.g. jdelacruz" autocomplete="off" />
            </div>
          </div>
          <div class="col-full">
            <label class="field-label" for="editEmail">Email <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <input type="email" id="editEmail" name="librarianEmail" required class="modal-input" placeholder="juan@school.edu.ph" autocomplete="off" />
            </div>
          </div>
          <div>
            <label class="field-label" for="editFirstName">First Name <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="editFirstName" name="librarianFirstName" required class="modal-input" placeholder="Juan" autocomplete="off" />
            </div>
          </div>
          <div>
            <label class="field-label" for="editLastName">Last Name <span class="req">*</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <input type="text" id="editLastName" name="librarianLastName" required class="modal-input" placeholder="Dela Cruz" autocomplete="off" />
            </div>
          </div>
          <div class="col-full">
            <label class="field-label" for="editContact">Contact Number <span class="opt">(optional)</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <input type="text" id="editContact" name="librarianContactNumber" class="modal-input" placeholder="+63 9XX XXX XXXX" autocomplete="off" />
            </div>
          </div>
          <!-- ✅ NEW: Date Registered (read-only) -->
          <div class="col-full">
            <label class="field-label" for="editDateRegistered">Date Registered <span class="opt">(read-only)</span></label>
            <div class="field-wrap">
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <input type="text" id="editDateRegistered" class="modal-input" readonly tabindex="-1" />
            </div>
          </div>
        </div>
      </div>
      <div class="form-divider"></div>
      <div class="modal-footer-btns">
        <button type="button" class="btn-secondary" id="cancelEditBottom">Cancel</button>
        <button type="submit" class="btn-primary">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Update
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ══ DELETE MODAL ══ -->
<div class="modal-overlay hidden" id="deleteModal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon danger">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#f87171" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Delete Librarian</div>
        <div class="modal-head-sub">This action cannot be undone</div>
      </div>
    </div>
    <div class="modal-body">Are you sure you want to delete this librarian? All associated data will be permanently removed.</div>
    <div class="modal-footer-btns">
      <button type="button" class="btn-secondary" id="cancelDeleteBtn">Cancel</button>
      <button type="button" class="btn-danger" id="confirmDeleteBtn">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Delete
      </button>
    </div>
  </div>
</div>

<!-- ══ RESET PASSWORD MODAL ══ -->
<div class="modal-overlay hidden" id="resetModal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon info">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Reset Password</div>
        <div class="modal-head-sub">Set a new password for this librarian</div>
      </div>
      <button type="button" class="btn-close" id="closeResetModal">
        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div style="padding:18px 20px;">
      <label class="field-label" for="newPassword">New Password <span class="req">*</span></label>
      <div class="field-wrap">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"/></svg>
        <input type="password" id="newPassword" name="newPassword" class="modal-input" placeholder="Enter new password" autocomplete="new-password" />
      </div>
    </div>
    <div class="form-divider"></div>
    <div class="modal-footer-btns">
      <button type="button" class="btn-secondary" id="cancelResetBtn">Cancel</button>
      <button type="button" class="btn-accent" id="confirmResetBtn">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Reset Password
      </button>
    </div>
  </div>
</div>

<div class="toast hidden" id="notificationToast"></div>

<script src="/librarianPagesScripts/viewAllLibrarian.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Students — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
   <link rel="stylesheet" href="/styles/usersStyles/viewAllUsers.css" />
<link rel="stylesheet" href="/styles/togglebutton/theme.css" />
   <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script>
  // Anti-flash on load
  (function(){
    if(localStorage.getItem('theme') === 'dark'){
      document.documentElement.classList.add('dark');
    }
  })();

  // Listen for toggle from parent dashboard
  window.addEventListener('storage', function(e){
    if(e.key === 'theme'){
      if(e.newValue === 'dark'){
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
  });
</script>
  <!-- Embed mode: hide sidebar when loaded inside iframe -->
  <script>
    if (new URLSearchParams(window.location.search).get('embed') === 'true') {
      document.documentElement.classList.add('embedded');
    }
  </script>
  <style>
    html.embedded .sidebar { display: none !important; }
    html.embedded .main    { margin-left: 0 !important; }
  </style>
  
</head>
<body>



<div class="main">
  <div class="topbar">
    <div class="topbar-left">
     
      <span class="topbar-title">Students</span>
    </div>
    
  </div>

  <div class="page-body">
     <div style="display:flex; justify-content:flex-end; margin-bottom:20px;">
      <button class="topbar-btn" id="openAddModalBtn">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Student
      </button>
    </div>
    <div class="table-card">
      <form method="GET" style="display:contents;">
        <div class="filter-bar">
          <div class="filter-search">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
            <input type="text" name="search" class="filter-input" placeholder="Search by name, ID, email…" value="<%= filters.search %>" />
          </div>
          <div class="select-wrap">
            <select name="grade" class="filter-select" onchange="this.form.submit()">
              <option value="">All Grades</option>
              <option value="11" <%= filters.grade === "11" ? "selected" : "" %>>Grade 11</option>
              <option value="12" <%= filters.grade === "12" ? "selected" : "" %>>Grade 12</option>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <div class="select-wrap">
            <select name="section" class="filter-select" onchange="this.form.submit()">
              <option value="">All Sections</option>
              <% if (filters.grade === "11") { %>
                <% ["Jupiter", "Mars", "Venus", "Earth"].forEach(sec => { %>
                  <option value="<%= sec %>" <%= filters.section === sec ? "selected" : "" %>><%= sec %></option>
                <% }) %>
              <% } %>
              <% if (filters.grade === "12") { %>
                <% ["Pluto", "Saturn", "Neptune", "Mercury"].forEach(sec => { %>
                  <option value="<%= sec %>" <%= filters.section === sec ? "selected" : "" %>><%= sec %></option>
                <% }) %>
              <% } %>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <!-- Preserve embed param on form submit -->
          <input type="hidden" name="embed" value="true" />
          <button type="submit" class="btn-search">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
            Search
          </button>
        </div>
      </form>

      <div style="overflow-x:auto;">
        <table id="studentsTable">
          <thead>
            <tr>
              <th>ID Number</th><th>First Name</th><th>Last Name</th>
              <th>Grade</th><th>Section</th><th>Email</th><th>Contact</th><th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (students && students.length > 0) { %>
              <% students.forEach(student => { %>
              <tr
                data-student-id="<%= student.student_id %>"
                data-first-name="<%= student.first_name %>"
                data-last-name="<%= student.last_name %>"
                data-grade="<%= student.grade %>"
                data-section="<%= student.section %>"
                data-email="<%= student.email %>"
                data-contact="<%= student.contact_number ?? '' %>"
              >
                <td><span class="student-id"><%= student.student_id %></span></td>
                <td><span class="student-name"><%= student.first_name %></span></td>
                <td><span class="student-name"><%= student.last_name %></span></td>
                <td><span class="grade-badge grade-<%= student.grade %>">Grade <%= student.grade %></span></td>
                <td><%= student.section %></td>
                <td style="color:var(--text-muted);font-size:12.5px;"><%= student.email %></td>
                <td style="font-family:'DM Mono',monospace;font-size:12px;"><%= student.contact_number ?? '—' %></td>
                <td>
                  <div class="actions-cell">
                    <button type="button" class="action-btn edit editBtn" title="Edit">
                      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    <button type="button" class="action-btn del deleteBtn" title="Delete">
                      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr class="no-data"><td colspan="8">No students found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <p class="page-info"><span><%= total %></span> total students</p>
        <div class="pg-btns">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage-1 %>&grade=<%= filters.grade %>&section=<%= filters.section %>&search=<%= filters.search %>&embed=true" class="pg-btn">
              <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg> Prev
            </a>
          <% } else { %>
            <span class="pg-btn disabled"><svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg> Prev</span>
          <% } %>
          <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>&grade=<%= filters.grade %>&section=<%= filters.section %>&search=<%= filters.search %>&embed=true" class="pg-num <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage+1 %>&grade=<%= filters.grade %>&section=<%= filters.section %>&search=<%= filters.search %>&embed=true" class="pg-btn">
              Next <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          <% } else { %>
            <span class="pg-btn disabled">Next <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="modal-overlay hidden" id="editBackdrop" aria-hidden="true">
  <div class="modal-box">
    <div class="modal-head">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="modal-icon-wrap" style="background:var(--accent-dim);">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        </div>
        <div><div class="modal-head-title">Edit Student</div><div class="modal-head-sub">Update student information</div></div>
      </div>
      <button class="modal-close-btn" id="closeEditModalBtn"><svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <form id="editForm" class="modal-body">
      <input type="hidden" id="editCurrentStudentId" />
      <div class="modal-grid">
        <div class="col-2">
          <label class="field-label" for="editStudentId">Student ID <span class="req">*</span></label>
          <input type="text" id="editStudentId" name="studentId" required class="modal-input" placeholder="e.g. 1234567" />
        </div>
        <div>
          <label class="field-label" for="editFirstName">First Name <span class="req">*</span></label>
          <input type="text" id="editFirstName" name="studentFirstName" required class="modal-input" placeholder="Juan" />
        </div>
        <div>
          <label class="field-label" for="editLastName">Last Name <span class="req">*</span></label>
          <input type="text" id="editLastName" name="studentLastName" required class="modal-input" placeholder="Dela Cruz" />
        </div>
        <div>
          <label class="field-label" for="editGrade">Grade <span class="req">*</span></label>
          <div class="select-field">
            <select id="editGrade" name="studentGrade" required class="modal-select">
              <option value="">Select Grade</option>
              <option value="11">Grade 11</option>
              <option value="12">Grade 12</option>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        <div>
          <label class="field-label" for="editSection">Section <span class="req">*</span></label>
          <div class="select-field">
            <select id="editSection" name="studentSection" required class="modal-select">
              <option value="">Select Section</option>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        <div class="col-2">
          <label class="field-label" for="editEmail">Email <span class="req">*</span></label>
          <input type="email" id="editEmail" name="studentEmail" required class="modal-input" placeholder="juan@school.edu.ph" />
        </div>
        <div class="col-2">
          <label class="field-label" for="editContact">Contact Number <span style="color:var(--text-muted);font-weight:400;text-transform:none;letter-spacing:0;">(optional)</span></label>
          <input type="tel" id="editContact" name="studentContactNumber" class="modal-input" placeholder="+63 9XX XXX XXXX" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="cancelEditBtn">Cancel</button>
        <button type="submit" class="btn-submit">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Update
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ADD MODAL -->
<div class="modal-overlay hidden" id="addBackdrop" aria-hidden="true">
  <div class="modal-box">
    <div class="modal-head">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="modal-icon-wrap" style="background:var(--accent-dim);">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
        </div>
        <div><div class="modal-head-title">Add Student</div><div class="modal-head-sub">Register a new student</div></div>
      </div>
      <button class="modal-close-btn" id="closeAddModalBtn"><svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <form id="addForm" class="modal-body">
      <div class="modal-grid">
        <div class="col-2">
          <label class="field-label">Student ID <span class="req">*</span></label>
          <input type="text" id="addStudentId" name="studentId" required class="modal-input" placeholder="e.g. 1234567" />
          <p id="addStudentIdErr" class="inline-err"></p>
        </div>
        <div>
          <label class="field-label">First Name <span class="req">*</span></label>
          <input type="text" id="addFirstName" name="studentFirstName" required class="modal-input" placeholder="Juan" />
          <p id="addFirstNameErr" class="inline-err"></p>
        </div>
        <div>
          <label class="field-label">Last Name <span class="req">*</span></label>
          <input type="text" id="addLastName" name="studentLastName" required class="modal-input" placeholder="Dela Cruz" />
          <p id="addLastNameErr" class="inline-err"></p>
        </div>
        <div>
          <label class="field-label">Grade <span class="req">*</span></label>
          <div class="select-field">
            <select id="addGrade" name="studentGrade" required class="modal-select">
              <option value="">Select Grade</option>
              <option value="11">Grade 11</option>
              <option value="12">Grade 12</option>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <p id="addGradeErr" class="inline-err"></p>
        </div>
        <div>
          <label class="field-label">Section <span class="req">*</span></label>
          <div class="select-field">
            <select id="addSection" name="studentSection" required class="modal-select">
              <option value="">Select Section</option>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <p id="addSectionErr" class="inline-err"></p>
        </div>
        <div class="col-2">
          <label class="field-label">Email <span class="req">*</span></label>
          <input type="email" id="addEmail" name="studentEmail" required class="modal-input" placeholder="juan@school.edu.ph" />
          <p id="addEmailErr" class="inline-err"></p>
        </div>
        <div class="col-2">
          <label class="field-label">Contact Number <span style="color:var(--text-muted);font-weight:400;text-transform:none;letter-spacing:0;">(optional)</span></label>
          <input type="tel" id="addContact" name="studentContactNumber" class="modal-input" placeholder="+63 9XX XXX XXXX" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="cancelAddBtn">Cancel</button>
        <button type="submit" class="btn-submit" id="addSubmitBtn">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          Register
        </button>
      </div>
    </form>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay hidden" id="deleteBackdrop" aria-hidden="true">
  <div class="modal-box delete-modal-box">
    <div class="modal-head">
      <div style="display:flex;align-items:center;gap:10px;">
        <div class="delete-icon-wrap">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#f87171" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        </div>
        <div><div class="modal-head-title">Delete Student</div><div class="modal-head-sub" id="deleteModalMessage">This action cannot be undone.</div></div>
      </div>
      <button class="modal-close-btn" id="closeDeleteModalBtn"><svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div style="padding:16px 20px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--border);">
      <button type="button" class="btn-secondary" id="cancelDeleteBtn">Cancel</button>
      <button type="button" class="btn-danger" id="confirmDeleteBtn">Delete</button>
    </div>
  </div>
</div>

<div class="toast hidden" id="notifToast"></div>

<script>
  function toggleTrans(btn) {
    const sub = document.getElementById('transSubmenu');
    btn.classList.toggle('open', sub.classList.toggle('open'));
  }
  function toggleProfile() {
    const panel = document.getElementById('profilePanel');
    const chevron = document.getElementById('profileChevron');
    const isOpen = panel.classList.toggle('open');
    chevron.style.transform = isOpen ? 'rotate(180deg)' : '';
  }
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#profileWrap')) {
      document.getElementById('profilePanel').classList.remove('open');
      document.getElementById('profileChevron').style.transform = '';
    }
  });
</script>
<script src="/usersScripts/viewAllUsers.js"></script>
</body>
</html>

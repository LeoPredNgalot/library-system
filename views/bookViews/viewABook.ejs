<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>View Book — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  
  <link rel="stylesheet" href="/styles/togglebutton/theme.css" />
  <link rel="stylesheet" href="/styles/bookPagesStyleFolder/viewABook.css" />
  <script>
  // Anti-flash on load
  (function(){
    if(localStorage.getItem('theme') === 'dark'){
      document.documentElement.classList.add('dark');
    }
  })();

  // Listen for toggle from parent dashboard
  window.addEventListener('storage', function(e){
    if(e.key === 'theme'){
      if(e.newValue === 'dark'){
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
  });
</script>
</head>


<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-left">
    <span class="topbar-eyebrow">Books</span>
    <span class="topbar-title">Book Details</span>
  </div>
  <button type="button" id="backBtn" class="back-btn">
    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    Back to Books
  </button>
</div>

<div class="page-body">
  <div class="view-layout">

    <!-- ── LEFT COLUMN ── -->
    <div style="display:flex; flex-direction:column; gap:16px;">

      <!-- Cover Photo -->
      <div class="card">
        <div class="card-head">
          <div class="card-icon">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <div>
            <div class="card-title">Book Cover</div>
            <div class="card-sub"><%= book.title %></div>
          </div>
        </div>
        <div class="card-body">
          <div class="cover-display">
            <% if (book.book_photo_file_path) { %>
              <img src="/uploads/<%= book.book_photo_file_path %>" alt="Cover of <%= book.title %>" />
            <% } else { %>
              <div class="cover-no-photo">
                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="#3d5a73" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                No Photo
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Copy Status Summary -->
      <div class="card">
        <div class="card-head">
          <div class="card-icon">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          </div>
          <div>
            <div class="card-title">Copy Status</div>
            <div class="card-sub">Tracks as of today</div>
          </div>
        </div>
        <div class="count-summary-grid">
          <div class="count-row">
            <span class="count-row-label">Total Copies</span>
            <span class="count-row-value accent"><%= book.total_copies %></span>
          </div>
          <div class="count-row">
            <span class="count-row-label">Available</span>
            <span class="count-row-value green"><%= book.available_count %></span>
          </div>
          <div class="count-row">
            <span class="count-row-label">Borrowed</span>
            <span class="count-row-value yellow"><%= book.borrowed_count %></span>
          </div>
          <div class="count-row">
            <span class="count-row-label">Lost</span>
            <span class="count-row-value red"><%= book.lost_count %></span>
          </div>
          <div class="count-row">
            <span class="count-row-label">Damaged</span>
            <span class="count-row-value orange"><%= book.damaged_count %></span>
          </div>
        </div>
      </div>

    </div><!-- end left column -->

    <!-- ── RIGHT COLUMN ── -->
    <div class="card" style="animation-delay:0.08s;">
      <div class="card-head">
        <div class="card-icon">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <div>
          <div class="card-title">Book Information</div>
          <div class="card-sub">Full details of this book</div>
        </div>
      </div>
      <div class="card-body">

        <div class="book-title-block">
          <h1><%= book.title %></h1>
          <div class="book-author">by <%= book.author %></div>
        </div>

        <div class="info-divider"></div>

        <div class="meta-grid">
          <div class="meta-field">
            <span class="meta-label">Genre</span>
            <%
              const gc = { MATH:'genre-MATH', ENGLISH:'genre-ENGLISH', SCIENCE:'genre-SCIENCE', HISTORY:'genre-HISTORY', FICTION:'genre-FICTION', FILIPINO:'genre-FILIPINO', LITERATURE:'genre-LITERATURE' }[(book.genre||'').toUpperCase()] || '';
            %>
            <div class="meta-value">
              <% if (book.genre) { %>
                <span class="genre-badge <%= gc %>"><%= book.genre %></span>
              <% } else { %>
                —
              <% } %>
            </div>
          </div>
          <div class="meta-field">
            <span class="meta-label">Shelf Location</span>
            <div class="meta-value"><%= book.book_location || '—' %></div>
          </div>
          <div class="meta-field">
            <span class="meta-label">Publisher</span>
            <div class="meta-value"><%= book.publisher || '—' %></div>
          </div>
          <div class="meta-field">
            <span class="meta-label">ISBN</span>
            <div class="meta-value mono"><%= book.isbn || '—' %></div>
          </div>
          <div class="meta-field">
            <span class="meta-label">Year Published</span>
            <div class="meta-value"><%= book.year_published || '—' %></div>
          </div>
          <div class="meta-field">
            <span class="meta-label">Date Added</span>
            <div class="meta-value"><%= book.date_added || '—' %></div>
          </div>
        </div>

        <!-- ── COPIES (mirrors update book copies section style) ── -->
        <div class="copies-section">
          <div class="copies-header">
            <span class="copies-title-lbl">Book Copies</span>
            <span class="copy-count-badge">Total: <strong><%= bookCopies.length %></strong></span>
          </div>

          <div class="copies-scroll-area">
            <% if (bookCopies.length > 0) { %>
              <% bookCopies.forEach(copy => { %>
              <%
                const isLost     = copy.lost     === 1 || copy.lost     === true;
                const isDamaged  = copy.damaged  === 1 || copy.damaged  === true;
                const isBorrowed = copy.borrowed === 1 || copy.borrowed === true;
                const isReserved = copy.reserved === 1 || copy.reserved === true;
                const issues     = [];
                if (isLost)    issues.push("lost");
                if (isDamaged) issues.push("damaged");
                const isAvailable = !isBorrowed && !isReserved && issues.length === 0;
              %>
              <div class="copy-row">
                <span class="copy-id-text"><%= copy.copy_id %></span>
                <% if (isAvailable) { %>
                  <span class="badge badge-available">Available</span>
                <% } else if (isBorrowed) { %>
                  <span class="badge badge-borrowed">Borrowed</span>
                <% } else if (isReserved) { %>
                  <span class="badge badge-reserved">Reserved</span>
                <% } else { %>
                  <span class="badge badge-unavailable">Not available — <%= issues.join(", ") %></span>
                <% } %>
              </div>
              <% }) %>
            <% } else { %>
              <div class="no-copies">No copies found for this book.</div>
            <% } %>
          </div>
        </div>

      </div>
    </div><!-- end right column -->

  </div>
</div>

<script src="/bookPagesScripts/viewABook.js"></script>
<script src="/toggle/theme.js"></script>
</body>
</html>
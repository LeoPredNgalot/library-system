<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/userAuthenticationStyles/loginPage.css" />
  <script>
  (function(){
    if(localStorage.getItem('theme') === 'dark'){
      document.documentElement.classList.add('dark');
    }
  })();
</script>
</head>
<body>

  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <div class="page">

    <!-- School Logo — outside the card -->
    <div style="display:flex; flex-direction:column; align-items:center; gap:20px; width:100%; max-width:420px;">

      

    <div class="card" style="width:100%;">

      <!-- Brand -->
      <div class="brand">
        <div class="brand-icon" style="background:none; box-shadow:none; overflow:hidden; width:68px; height:68px;">
          <img src="/images/voctechlogo_3.png" alt="School Logo" style="width:60px; height:60px; object-fit:contain;" />
        </div>
        <div class="brand-text">
          <div class="brand-name">Voctech Library</div>
          <div class="brand-sub">Management System</div>
        </div>
      </div>

      <!-- Heading -->
      <div class="heading">
        <h1>Welcome back</h1>
        <p>Sign in to your account to continue</p>
      </div>

      <!-- Error -->
      <div class="error-msg" id="errorMsg">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        <span id="errorText">Invalid username or password.</span>
      </div>

      <!-- Form -->
      <form id="form" novalidate>

        <div class="field">
          <label for="userName">Username</label>
          <div class="input-wrap">
            <input
              type="text"
              id="userName"
              name="userName"
              placeholder="Enter your username"
              autocomplete="username"
              required
            />
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
            </span>
          </div>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            />
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1 1.7 0 3.1 1.4 3.1 3.1v2z"/></svg>
            </span>
            <button type="button" class="toggle-pw" id="togglePw" aria-label="Show password">
              <svg id="eyeIcon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-login" id="loginBtn">
          <div class="spinner"></div>
          <span class="btn-label">Sign In</span>
        </button>

      </form>

      <p class="login-hint">Access is restricted to authorized personnel only.</p>

    </div>
    </div><!-- end flex wrapper -->
  </div>

  <script>
    const form      = document.getElementById("form");
    const loginBtn  = document.getElementById("loginBtn");
    const errorMsg  = document.getElementById("errorMsg");
    const errorText = document.getElementById("errorText");
    const togglePw  = document.getElementById("togglePw");
    const pwInput   = document.getElementById("password");
    const eyeIcon   = document.getElementById("eyeIcon");

    // Password visibility toggle
    togglePw.addEventListener("click", () => {
      const isHidden = pwInput.type === "password";
      pwInput.type = isHidden ? "text" : "password";
      eyeIcon.innerHTML = isHidden
        ? '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46A11.8 11.8 0 0 0 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78 3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>'
        : '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
    });

    // Form submit
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorMsg.classList.remove("visible");

      // Loading state
      loginBtn.disabled = true;
      loginBtn.classList.add("loading");

      const formData = new FormData(form);

      try {
        const request = await fetch("/librarian/login", {
          method: "POST",
          body: formData,
        });

        const serverResponse = await request.json();

        if (serverResponse.success === true) {
          window.location.href = serverResponse.redirectUrl;
        } else {
          errorText.textContent = serverResponse.message || "Invalid username or password.";
          errorMsg.classList.add("visible");
          loginBtn.disabled = false;
          loginBtn.classList.remove("loading");
        }
      } catch (err) {
        errorText.textContent = "Network error. Please try again.";
        errorMsg.classList.add("visible");
        loginBtn.disabled = false;
        loginBtn.classList.remove("loading");
      }
    });
  </script>

</body>
</html>
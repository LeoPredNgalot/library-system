<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:      #07111d;
      --bg-sidebar:   #0a1828;
      --bg-main:      #080f1a;
      --bg-card:      #0d1e30;
      --bg-card-hover:#102236;
      --bg-input:     #091522;
      --border:       rgba(255,255,255,0.06);
      --border-light: rgba(255,255,255,0.09);
      --accent:       #22d3ee;
      --accent-dim:   rgba(34,211,238,0.12);
      --accent-glow:  rgba(34,211,238,0.18);
      --text-primary: #ddeeff;
      --text-secondary:#7a9bb8;
      --text-muted:   #3d5a73;
      --sidebar-w:    220px;
      --radius:       12px;
    }

    html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: var(--bg-deep); color: var(--text-primary); overflow: hidden; }

    /* ══ SIDEBAR ══ */
    .sidebar {
      position: fixed; top: 0; left: 0; bottom: 0;
      width: var(--sidebar-w);
      background: var(--bg-sidebar);
      border-right: 1px solid var(--border);
      display: flex; flex-direction: column;
      z-index: 50;
    }
    .sidebar-logo {
      display: flex; align-items: center; gap: 10px;
      padding: 20px 18px 18px;
      border-bottom: 1px solid var(--border);
    }
    .logo-icon {
      width: 34px; height: 34px; border-radius: 9px;
      background: linear-gradient(135deg, #0e7490, #22d3ee);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 16px rgba(34,211,238,0.22);
      flex-shrink: 0;
    }
    .logo-name { font-size: 14px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
    .logo-sub  { font-size: 10px; color: var(--text-muted); letter-spacing: 0.06em; text-transform: uppercase; margin-top: 1px; }

    .sidebar-nav { flex: 1; overflow-y: auto; padding: 14px 10px; }
    .sidebar-nav::-webkit-scrollbar { width: 3px; }
    .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }

    .nav-label {
      font-size: 10px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-muted);
      padding: 6px 8px 4px; margin-top: 8px;
    }
    .nav-link {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 10px; border-radius: 8px;
      font-size: 13.5px; font-weight: 500; color: var(--text-secondary);
      text-decoration: none; cursor: pointer;
      transition: background 0.15s, color 0.15s;
      user-select: none;
    }
    .nav-link:hover { background: rgba(34,211,238,0.06); color: var(--text-primary); }
    .nav-link.active { background: var(--accent-dim); color: var(--accent); }
    .nav-link.active svg { stroke: var(--accent); opacity: 1; }
    .nav-link svg { flex-shrink: 0; opacity: 0.75; }

    .nav-chevron { margin-left: auto; transition: transform 0.2s; opacity: 0.5; }
    .nav-link.open .nav-chevron { transform: rotate(180deg); }
    .nav-submenu { overflow: hidden; max-height: 0; transition: max-height 0.25s ease; }
    .nav-submenu.open { max-height: 80px; }
    .nav-submenu .nav-link { padding-left: 30px; font-size: 13px; }

    .sidebar-footer { border-top: 1px solid var(--border); padding: 12px 10px; position: relative; }
    .profile-btn {
      width: 100%; display: flex; align-items: center; gap: 9px;
      background: none; border: none; cursor: pointer;
      padding: 8px 10px; border-radius: 8px;
      transition: background 0.15s; text-align: left;
    }
    .profile-btn:hover { background: rgba(255,255,255,0.04); }
    .avatar {
      width: 32px; height: 32px; border-radius: 8px;
      background: linear-gradient(135deg, #0e7490, #22d3ee);
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700; color: white; flex-shrink: 0;
    }
    .profile-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .profile-role { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
    .profile-chevron { margin-left: auto; color: var(--text-muted); transition: transform 0.2s; }

    .profile-panel {
      position: absolute; bottom: calc(100% + 6px); left: 10px; right: 10px;
      background: #0f2035; border: 1px solid var(--border-light);
      border-radius: 10px; overflow: hidden;
      opacity: 0; pointer-events: none; transform: translateY(6px);
      transition: opacity 0.18s, transform 0.18s;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    .profile-panel.open { opacity: 1; pointer-events: all; transform: translateY(0); }
    .profile-panel-header { padding: 12px 14px; border-bottom: 1px solid var(--border); }
    .profile-panel-header p { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .profile-panel-header small { font-size: 11px; color: var(--text-muted); }
    .panel-item {
      display: flex; align-items: center; gap: 8px;
      padding: 9px 14px; font-size: 13px; color: var(--text-secondary);
      text-decoration: none; transition: background 0.12s, color 0.12s;
    }
    .panel-item:hover { background: rgba(255,255,255,0.04); color: var(--text-primary); }
    .panel-item.danger { color: #f87171; }
    .panel-item.danger:hover { background: rgba(248,113,113,0.08); }

    /* ══ MAIN ══ */
    .main { margin-left: var(--sidebar-w); height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
    .page-body { flex: 1; overflow-y: auto; padding: 24px 28px; background: var(--bg-main); }
    .page-body::-webkit-scrollbar { width: 4px; }
    .page-body::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }

    /* Greeting */
    .greeting {
      background: linear-gradient(120deg, #0d2540 0%, #0a1e35 60%, #071828 100%);
      border: 1px solid var(--border-light); border-radius: var(--radius);
      padding: 22px 26px; display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 22px; position: relative; overflow: hidden;
    }
    .greeting::before {
      content: ''; position: absolute; right: -40px; top: -40px;
      width: 180px; height: 180px;
      background: radial-gradient(circle, rgba(34,211,238,0.07) 0%, transparent 70%);
      pointer-events: none;
    }
    .greeting-hello { font-size: 11px; color: var(--accent); font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 4px; }
    .greeting-name  { font-size: 21px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
    .greeting-desc  { font-size: 13px; color: var(--text-secondary); margin-top: 3px; }
    .greeting-date  { text-align: right; }
    .greeting-day   { font-size: 38px; font-weight: 700; color: var(--text-primary); font-family: 'DM Mono', monospace; line-height: 1; }
    .greeting-dayname { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 22px; }
    .stat-card {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 18px 20px; display: flex; align-items: center; gap: 14px;
      transition: border-color 0.2s, transform 0.15s; animation: fadeUp 0.4s ease both;
    }
    .stat-card:hover { border-color: var(--border-light); transform: translateY(-2px); }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    .stat-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .stat-value { font-size: 24px; font-weight: 700; color: var(--text-primary); font-family: 'DM Mono', monospace; letter-spacing: -0.02em; line-height: 1; }
    .stat-label { font-size: 12px; color: var(--text-secondary); margin-top: 3px; }
    .stat-sub   { font-size: 11px; margin-top: 2px; }
    .stat-sub.green  { color: #34d399; }
    .stat-sub.yellow { color: #fbbf24; }
    .stat-sub.red    { color: #f87171; }
    .stat-sub.blue   { color: var(--accent); }

    /* ══ DASH GRID — 3 columns, equal height ══ */
    .dash-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 280px;
      gap: 16px;
      align-items: stretch;
    }
    .dash-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      animation: fadeUp 0.45s ease both;
      display: flex;
      flex-direction: column;
    }
    .dash-card-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
    .dash-card-head-left { display: flex; align-items: center; gap: 10px; }
    .dash-icon { width: 30px; height: 30px; border-radius: 8px; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; }
    .dash-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
    .dash-sub   { font-size: 12px; color: var(--text-muted); margin-top: 1px; }
    .dash-link  { font-size: 12px; color: var(--accent); font-weight: 500; padding: 4px 10px; border-radius: 6px; transition: background 0.15s; cursor: pointer; background: none; border: none; font-family: inherit; text-decoration: none; }
    .dash-link:hover { background: var(--accent-dim); }

    /* Rec list — scrollable to fill remaining space */
    .rec-list {
      display: flex; flex-direction: column; gap: 2px; padding: 8px 12px 12px;
      flex: 1; overflow-y: auto;
    }
    .rec-list::-webkit-scrollbar { width: 3px; }
    .rec-list::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 2px; }
    .rec-item { display: flex; align-items: center; gap: 12px; padding: 10px 8px; border-radius: 9px; transition: background 0.12s; }
    .rec-item:hover { background: rgba(255,255,255,0.03); }
    .rec-cover { width: 46px; height: 58px; border-radius: 6px; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .rec-cover img { width: 100%; height: 100%; object-fit: cover; }
    .rec-cover-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .rec-info { flex: 1; min-width: 0; }
    .rec-title { font-size: 13px; font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rec-meta  { font-size: 11.5px; color: var(--text-muted); margin-top: 2px; }
    .rec-badge { font-size: 10.5px; font-weight: 600; padding: 3px 8px; border-radius: 20px; flex-shrink: 0; }
    .rec-badge.available { background: rgba(52,211,153,0.1);  color: #34d399; }
    .rec-badge.borrowed  { background: rgba(251,191,36,0.1);  color: #fbbf24; }
    .rec-badge.reserved  { background: rgba(34,211,238,0.1);  color: var(--accent); }
    .no-data { text-align: center; padding: 36px 20px; font-size: 13px; color: var(--text-muted); }

    /* Quick actions — flex-fill */
    .quick-actions { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .qa-btn {
      display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 9px;
      background: var(--bg-input); border: 1px solid var(--border);
      color: var(--text-secondary); font-size: 13px; font-weight: 500;
      font-family: 'DM Sans', sans-serif; text-decoration: none; cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .qa-btn:hover { background: var(--accent-dim); border-color: rgba(34,211,238,0.2); color: var(--text-primary); }
    .qa-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

    /* Calendar — flex-fill */
    .cal-wrap { padding: 14px 18px; flex: 1; }
    .cal-grid-head { display: grid; grid-template-columns: repeat(7,1fr); gap: 2px; margin-bottom: 6px; }
    .cal-grid-head span { text-align: center; font-size: 10px; font-weight: 600; color: var(--text-muted); padding: 4px 0; }
    .cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 2px; }
    .cal-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 6px; font-size: 12px; color: var(--text-secondary); cursor: default; transition: background 0.12s; }
    .cal-day:hover { background: rgba(255,255,255,0.04); }
    .cal-day.other { color: var(--text-muted); opacity: 0.4; }
    .cal-day.today { background: var(--accent); color: #000; font-weight: 700; border-radius: 7px; }
    .cal-nav { display: flex; align-items: center; gap: 6px; }
    .cal-nav-btn { width: 26px; height: 26px; border-radius: 6px; background: var(--bg-input); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-secondary); transition: background 0.12s, color 0.12s; }
    .cal-nav-btn:hover { background: var(--accent-dim); color: var(--accent); }

    /* ══ LOGOUT MODAL ══ */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(4, 10, 18, 0.75);
      backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .modal-backdrop.open { opacity: 1; pointer-events: all; }
    .modal {
      background: #0d1e30;
      border: 1px solid var(--border-light);
      border-radius: 16px;
      padding: 28px 28px 22px;
      width: 100%; max-width: 360px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.5), 0 0 0 1px rgba(34,211,238,0.06);
      transform: translateY(10px) scale(0.97);
      transition: transform 0.22s ease;
      text-align: center;
    }
    .modal-backdrop.open .modal { transform: translateY(0) scale(1); }
    .modal-icon {
      width: 52px; height: 52px; border-radius: 14px;
      background: rgba(248,113,113,0.1);
      border: 1px solid rgba(248,113,113,0.18);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 18px;
    }
    .modal-title { font-size: 16px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; margin-bottom: 8px; }
    .modal-desc  { font-size: 13px; color: var(--text-secondary); line-height: 1.55; margin-bottom: 24px; }
    .modal-actions { display: flex; gap: 10px; }
    .modal-btn {
      flex: 1; padding: 10px 0; border-radius: 9px;
      font-size: 13.5px; font-weight: 600; font-family: 'DM Sans', sans-serif;
      cursor: pointer; border: none; transition: background 0.15s, transform 0.1s;
    }
    .modal-btn:active { transform: scale(0.97); }
    .modal-btn.cancel { background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border-light); }
    .modal-btn.cancel:hover { background: #102236; color: var(--text-primary); }
    .modal-btn.confirm { background: rgba(248,113,113,0.12); color: #f87171; border: 1px solid rgba(248,113,113,0.22); }
    .modal-btn.confirm:hover { background: rgba(248,113,113,0.2); }
  </style>
</head>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/togglebutton/theme.css" />
  <link rel="stylesheet" href="/styles/adminPagesStyle/adminHomepage.css" />
  <script>
    (function(){
      if(localStorage.getItem('theme') === 'dark'){
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body>

<!-- ══ SIDEBAR ══ -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">
      <img src="/images/voctechlogo_3.png" alt="School Logo" style="width:32px;height:32px;object-fit:contain;" />
    </div>
    <div>
      <div class="logo-name">Voctech Library</div>
      <div class="logo-sub">Management System</div>
    </div>
  </div>

  <nav class="sidebar-nav">

    <a href="#" class="nav-link active" id="nav-home" onclick="showDashboard(); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Dashboard
    </a>
    <a href="#" class="nav-link" id="nav-books" onclick="navigateTo('books','Books','/book/get-all-books?embed=true'); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      Books
    </a>
    <a href="#" class="nav-link" id="nav-users" onclick="navigateTo('users','Students','/user/view-all-users?embed=true'); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      Students
    </a>
    <a href="#" class="nav-link" id="nav-librarians" onclick="navigateTo('librarians','Librarians','/librarian/view-all-librarians?embed=true'); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Librarians
    </a>

    <a class="nav-link" id="transBtn" onclick="toggleTrans(this); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Transactions
      <svg class="nav-chevron" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </a>
    <div class="nav-submenu" id="transSubmenu">
      <a href="#" class="nav-link" id="nav-borrow" onclick="navigateTo('borrow','Borrow Records','/transaction/borrow?embed=true'); return false;">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        Borrow
      </a>
      <a href="#" class="nav-link" id="nav-reserve" onclick="navigateTo('reserve','Reservations','/transaction/reservation?embed=true'); return false;">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
        Reservations
      </a>
    </div>

    <a href="#" class="nav-link" id="nav-inventory" onclick="navigateTo('inventory','Inventory Report','/reports/inventory?embed=true'); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Inventory Report
    </a>
    <a class="nav-link" href="#" onclick="navigateTo('profile','My Profile','/librarian/profile/me?embed=true'); return false;">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Profile Settings
    </a>
    <a href="#" class="nav-link" id="nav-settings" onclick="navigateTo('settings','Settings','/librarian/admin/settings?embed=true'); return false;">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Admin Settings
    </a>
  </nav>

  <div class="sidebar-footer" id="profileWrap">
    <button class="profile-btn" id="profileBtn" onclick="toggleProfile()">
      <div class="avatar">AD</div>
      <div>
        <div class="profile-name">Administrator</div>
        <div class="profile-role">Admin</div>
      </div>
      <svg class="profile-chevron" id="profileChevron" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="profile-panel" id="profilePanel">
      <div class="profile-panel-header">
        <p>Administrator</p>
        <small>Admin Account</small>
      </div>
      <a class="panel-item danger" href="#" onclick="openLogoutModal(); return false;">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Sign Out
      </a>
    </div>
  </div>
</aside>

<!-- ══ MAIN ══ -->
<div class="main">
  <div class="page-body" id="dashboardContent">

    <!-- Theme toggle -->
    <div style="display:flex;justify-content:flex-end;margin-bottom:10px;">
      <button class="theme-toggle-pill" id="themeToggle" onclick="toggleTheme()" title="Toggle light / dark">
        <span class="theme-toggle-icon">
          <svg id="themeIcon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"></svg>
        </span>
        <span class="theme-toggle-label" id="themeLabel">Light Mode</span>
      </button>
    </div>

    <!-- Greeting -->
    <div class="greeting">
      <div>
        <div class="greeting-hello" id="greetingText">Good morning</div>
        <div class="greeting-name">Admin 👋</div>
        <div class="greeting-desc">Here's your library overview for today.</div>
      </div>
      <div class="greeting-date">
        <div class="greeting-day" id="greetingDay"></div>
        <div class="greeting-dayname" id="greetingDayName"></div>
      </div>
    </div>

    <!-- Stats 3×2 -->
    <div class="stats-grid">
      <div class="stat-card" style="animation-delay:0.05s">
        <div class="stat-icon" style="background:rgba(14,165,233,0.1)">
          <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="#0ea5e9" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <div>
          <div class="stat-value" id="statTotalBooks">—</div>
          <div class="stat-label">Total Books</div>
          <div class="stat-sub blue">In collection</div>
        </div>
      </div>
      <div class="stat-card" style="animation-delay:0.1s">
        <div class="stat-icon" style="background:rgba(251,191,36,0.1)">
          <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="#fbbf24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        </div>
        <div>
          <div class="stat-value" id="statBorrowed">—</div>
          <div class="stat-label">Borrowed Books</div>
          <div class="stat-sub yellow">Currently out</div>
        </div>
      </div>
      <div class="stat-card" style="animation-delay:0.15s">
        <div class="stat-icon" style="background:rgba(52,211,153,0.1)">
          <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="#34d399" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <div class="stat-value" id="statReturned">—</div>
          <div class="stat-label">Returned Books</div>
          <div class="stat-sub green">This month</div>
        </div>
      </div>
      <div class="stat-card" style="animation-delay:0.2s">
        <div class="stat-icon" style="background:rgba(248,113,113,0.1)">
          <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="#f87171" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <div class="stat-value" id="statOverdue">—</div>
          <div class="stat-label">Overdue Books</div>
          <div class="stat-sub red">Needs attention</div>
        </div>
      </div>
      <div class="stat-card" style="animation-delay:0.25s">
        <div class="stat-icon" style="background:rgba(139,92,246,0.1)">
          <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="#a78bfa" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <div>
          <div class="stat-value" id="statUsers">—</div>
          <div class="stat-label">Total Users</div>
          <div class="stat-sub" style="color:#a78bfa">Registered</div>
        </div>
      </div>
      <div class="stat-card" style="animation-delay:0.3s">
        <div class="stat-icon" style="background:rgba(34,211,238,0.1)">
          <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
        </div>
        <div>
          <div class="stat-value" id="statReservations">—</div>
          <div class="stat-label">Active Reservations</div>
          <div class="stat-sub blue">Pending pickup</div>
        </div>
      </div>
    </div>

    <!-- ══ SECTION 1: RECOMMENDED BOOKS (genre-based algorithm) ══ -->
    <div class="dash-card" id="recBooksCard">
      <div class="dash-card-head">
        <div class="dash-card-head-left">
          <div class="dash-icon">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:var(--accent)">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
          </div>
          <div>
            <div class="dash-title">Recommended Books</div>
            <div class="dash-sub">Discover your next favorite read</div>
          </div>
        </div>
        <button class="dash-link" onclick="navigateTo('books','Books','/book/get-all-books?embed=true')">View all →</button>
      </div>
      <div class="rec-grid" id="recBooksBody">
        <div class="no-data">Loading recommendations…</div>
      </div>
    </div>

    <!-- ══ SECTION 2: MOST BORROWED BOOKS with genre filter ══ -->
    <div class="dash-card" style="margin-top:14px;">
      <div class="dash-card-head">
        <div class="dash-card-head-left">
          <div class="dash-icon">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:var(--accent)">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div>
            <div class="dash-title">Most Borrowed Books</div>
            <div class="dash-sub">Ranked by total borrow count</div>
          </div>
        </div>
        <button class="dash-link" onclick="navigateTo('books','Books','/book/get-all-books?embed=true')">View all →</button>
      </div>
      <!-- Genre filter tabs -->
      <div class="genre-filter-bar">
        <button class="genre-tab active" data-genre="all" onclick="filterByGenre(this,'all')">All</button>
        <button class="genre-tab" data-genre="MATH" onclick="filterByGenre(this,'MATH')">Math</button>
        <button class="genre-tab" data-genre="ENGLISH" onclick="filterByGenre(this,'ENGLISH')">English</button>
        <button class="genre-tab" data-genre="SCIENCE" onclick="filterByGenre(this,'SCIENCE')">Science</button>
        <button class="genre-tab" data-genre="HISTORY" onclick="filterByGenre(this,'HISTORY')">History</button>
        <button class="genre-tab" data-genre="FICTION" onclick="filterByGenre(this,'FICTION')">Fiction</button>
        <button class="genre-tab" data-genre="FILIPINO" onclick="filterByGenre(this,'FILIPINO')">Filipino</button>
        <button class="genre-tab" data-genre="LITERATURE" onclick="filterByGenre(this,'LITERATURE')">Literature</button>
      </div>
      <div class="rec-grid" id="mostBorrowedBody">
        <div class="no-data">Loading…</div>
      </div>
    </div>

  </div>

  <iframe id="contentFrame" src="" style="display:none;width:100%;flex:1;border:none;"></iframe>
</div>

<!-- ══ LOGOUT MODAL ══ -->
<div class="modal-backdrop" id="logoutModal">
  <div class="modal">
    <div class="modal-icon">
      <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#f87171" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
    </div>
    <div class="modal-title">Sign out?</div>
    <div class="modal-desc">You'll be logged out of your admin account and returned to the login page.</div>
    <div class="modal-actions">
      <button class="modal-btn cancel" onclick="closeLogoutModal()">Cancel</button>
      <a class="modal-btn confirm" href="/librarian/logout" style="display:flex;align-items:center;justify-content:center;text-decoration:none;">Sign Out</a>
    </div>
  </div>
</div>

<script>
  
</script>

<script src="/adminhomePageScript/adminhomepage2.js"></script>

<script src="/toggle/theme.js"></script>
</body>
</html>














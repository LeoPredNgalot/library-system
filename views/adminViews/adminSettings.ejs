<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Settings — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:      #07111d;
      --bg-main:      #080f1a;
      --bg-card:      #0d1e30;
      --bg-input:     #091522;
      --border:       rgba(255,255,255,0.06);
      --border-light: rgba(255,255,255,0.09);
      --accent:       #22d3ee;
      --accent-dim:   rgba(34,211,238,0.12);
      --text-primary: #ddeeff;
      --text-secondary:#7a9bb8;
      --text-muted:   #3d5a73;
      --radius:       12px;
      --topbar-h:     58px;
    }

    html, body {
      height: 100%;
      width: 100%;
      font-family: 'DM Sans', sans-serif;
      background: var(--bg-main);
      color: var(--text-primary);
      overflow-y: auto;
    }

    /* ── TOPBAR ── */
    .topbar {
      height: var(--topbar-h);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 28px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-main);
      position: sticky; top: 0; z-index: 10;
    }
    .topbar-left { display: flex; flex-direction: column; }
    .topbar-eyebrow { font-size: 10.5px; color: var(--text-muted); letter-spacing: 0.07em; text-transform: uppercase; }
    .topbar-title   { font-size: 17px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }

    /* ── PAGE BODY ── */
    .page-body {
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 100%;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── SECTION LABEL ── */
    .section-label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-muted);
      padding: 0 2px;
    }

    /* ── CARD ── */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      animation: fadeUp 0.4s ease both;
    }
    .card-header {
      display: flex; align-items: center; gap: 10px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
    }
    .card-icon {
      width: 30px; height: 30px; border-radius: 8px;
      background: var(--accent-dim);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .card-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
    .card-sub   { font-size: 12px; color: var(--text-muted); margin-top: 1px; }

    /* ── QUICK LINKS ── */
    .quick-links { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
    .ql-btn {
      display: flex; align-items: center; gap: 10px;
      padding: 11px 14px; border-radius: 9px;
      background: var(--bg-input); border: 1px solid var(--border);
      color: var(--text-secondary); font-size: 13px; font-weight: 500;
      font-family: 'DM Sans', sans-serif; text-decoration: none; cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .ql-btn:hover { background: var(--accent-dim); border-color: rgba(34,211,238,0.2); color: var(--text-primary); }
    .ql-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

    /* ── RESET PASSWORD FORM ── */
    .form-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 14px; }
    .form-row  { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label {
      font-size: 11.5px; font-weight: 600; color: var(--text-secondary);
      letter-spacing: 0.05em; text-transform: uppercase;
    }
    .field input {
      width: 100%; padding: 10px 14px;
      background: var(--bg-input); border: 1px solid var(--border-light);
      border-radius: 9px; color: var(--text-primary);
      font-size: 13.5px; font-family: 'DM Sans', sans-serif;
      outline: none; transition: border-color 0.15s, box-shadow 0.15s;
    }
    .field input:focus {
      border-color: rgba(34,211,238,0.35);
      box-shadow: 0 0 0 3px rgba(34,211,238,0.07);
    }
    .field input::placeholder { color: var(--text-muted); }
    .field .hint { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

    .form-actions {
      display: flex; justify-content: flex-start; gap: 10px;
      padding: 14px 20px;
      border-top: 1px solid var(--border);
    }
    .btn {
      padding: 9px 20px; border-radius: 9px;
      font-size: 13px; font-weight: 600; font-family: 'DM Sans', sans-serif;
      cursor: pointer; border: none; transition: background 0.15s, transform 0.1s;
    }
    .btn:active { transform: scale(0.97); }
    .btn-ghost  { background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border-light); }
    .btn-ghost:hover  { background: #102236; color: var(--text-primary); }
    .btn-accent { background: var(--accent-dim); color: var(--accent); border: 1px solid rgba(34,211,238,0.22); }
    .btn-accent:hover { background: rgba(34,211,238,0.2); }

    /* ── DANGER ZONE ── */
    .danger-header { padding: 16px 20px 12px; border-bottom: 1px solid var(--border); }
    .danger-title  { font-size: 14px; font-weight: 600; color: #f87171; }
    .danger-sub    { font-size: 12px; color: var(--text-muted); margin-top: 3px; line-height: 1.5; }

    .danger-note {
      display: flex; align-items: flex-start; gap: 8px;
      margin: 14px 20px 0;
      padding: 10px 14px;
      background: rgba(251,191,36,0.06);
      border: 1px solid rgba(251,191,36,0.15);
      border-radius: 8px;
      font-size: 12px; color: #fbbf24; line-height: 1.5;
    }

    .delete-list { padding: 12px 16px 16px; display: flex; flex-direction: column; gap: 6px; }
    .delete-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 11px 14px; border-radius: 9px;
      background: var(--bg-input); border: 1px solid var(--border);
      transition: border-color 0.15s, background 0.15s;
    }
    .delete-item:hover { background: rgba(248,113,113,0.05); border-color: rgba(248,113,113,0.2); }
    .delete-item-left  { display: flex; align-items: center; gap: 10px; }
    .delete-order {
      width: 20px; height: 20px; border-radius: 6px;
      background: rgba(248,113,113,0.1);
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 700; color: #f87171;
      flex-shrink: 0; font-family: 'DM Mono', monospace;
    }
    .delete-label { font-size: 13px; font-weight: 500; color: var(--text-secondary); }
    .delete-btn {
      padding: 5px 12px; border-radius: 7px;
      background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.2);
      color: #f87171; font-size: 12px; font-weight: 600;
      font-family: 'DM Sans', sans-serif; cursor: pointer;
      transition: background 0.15s; text-decoration: none;
    }
    .delete-btn:hover { background: rgba(248,113,113,0.16); }

    /* ── MODALS ── */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(4,10,18,0.75);
      backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .modal-backdrop.open { opacity: 1; pointer-events: all; }

    .modal {
      background: #0d1e30;
      border: 1px solid var(--border-light);
      border-radius: 16px;
      padding: 28px 28px 22px;
      width: 100%; max-width: 400px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.5);
      transform: translateY(10px) scale(0.97);
      transition: transform 0.22s ease;
    }
    .modal-backdrop.open .modal { transform: translateY(0) scale(1); }

    .modal-icon {
      width: 48px; height: 48px; border-radius: 13px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 16px;
    }
    .modal-icon.red    { background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.18); }
    .modal-icon.accent { background: var(--accent-dim);     border: 1px solid rgba(34,211,238,0.18); }

    .modal-title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
    .modal-sub   { font-size: 12px; color: var(--text-muted); margin-bottom: 20px; }
    .modal-sub span { color: #f87171; font-weight: 600; }

    .modal-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    .modal-field label { font-size: 11.5px; font-weight: 600; color: var(--text-secondary); letter-spacing: 0.05em; text-transform: uppercase; }
    .modal-field input {
      width: 100%; padding: 10px 14px;
      background: var(--bg-input); border: 1px solid var(--border-light);
      border-radius: 9px; color: var(--text-primary);
      font-size: 13.5px; font-family: 'DM Sans', sans-serif;
      outline: none; transition: border-color 0.15s;
    }
    .modal-field input:focus        { border-color: rgba(34,211,238,0.35); }
    .modal-field input.danger:focus { border-color: rgba(248,113,113,0.4); }
    .modal-field input::placeholder { color: var(--text-muted); }

    .modal-actions { display: flex; gap: 10px; margin-top: 6px; }
    .modal-btn {
      flex: 1; padding: 10px 0; border-radius: 9px;
      font-size: 13.5px; font-weight: 600; font-family: 'DM Sans', sans-serif;
      cursor: pointer; border: none; transition: background 0.15s, transform 0.1s;
    }
    .modal-btn:active { transform: scale(0.97); }
    .modal-btn.cancel               { background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border-light); }
    .modal-btn.cancel:hover         { background: #102236; color: var(--text-primary); }
    .modal-btn.confirm-red          { background: rgba(248,113,113,0.12); color: #f87171;     border: 1px solid rgba(248,113,113,0.22); }
    .modal-btn.confirm-red:hover    { background: rgba(248,113,113,0.2); }
    .modal-btn.confirm-accent       { background: var(--accent-dim); color: var(--accent);    border: 1px solid rgba(34,211,238,0.22); }
    .modal-btn.confirm-accent:hover { background: rgba(34,211,238,0.2); }

    /* ── TOAST ── */
    .toast {
      position: fixed; bottom: 24px; right: 24px; z-index: 300;
      padding: 12px 18px; border-radius: 10px;
      font-size: 13px; font-weight: 500;
      background: #0d1e30; border: 1px solid var(--border-light);
      color: var(--text-primary);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      transform: translateY(12px); opacity: 0;
      transition: all 0.25s ease; pointer-events: none;
      display: flex; align-items: center; gap: 8px;
    }
    .toast.show    { transform: translateY(0); opacity: 1; }
    .toast.success { border-color: rgba(52,211,153,0.3);  color: #34d399; }
    .toast.error   { border-color: rgba(248,113,113,0.3); color: #f87171; }
    .toast.info    { border-color: rgba(34,211,238,0.3);  color: var(--accent); }
  </style>
</head>
<body>

<!-- ── TOPBAR ── -->
<div class="topbar">
  <div class="topbar-left">
    
    <span class="topbar-title"> Admin Settings</span>
  </div>
</div>

<div class="page-body">

  

  <!-- ════════════════════════════════
       SECTION: RESET LIBRARIAN PASSWORD
  ════════════════════════════════ -->
 

  <div class="card" style="animation-delay:0.08s">
    <div class="card-header">
      <div class="card-icon">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
      </div>
      <div style="flex:1">
        <div class="card-title">Reset Admin Password</div>
        <div class="card-sub">Enter the Admin ID and a new password</div>
      </div>
    </div>
    <div class="form-body">
      <div class="form-row">
        <div class="field">
          <label>Admin ID</label>
          <input type="number" id="resetLibrarianId" placeholder="e.g. 3" min="1" />
        </div>
        <div class="field">
          <label>New Password</label>
          <input type="password" id="resetNewPassword" placeholder="Min. 6 characters" />
          <span class="hint">Must be at least 6 characters.</span>
        </div>
      </div>
    </div>
    <div class="form-actions">
      <button type="button" class="btn btn-ghost" id="clearResetBtn">Clear</button>
      <button type="button" class="btn btn-accent" id="submitResetBtn">Reset Password</button>
    </div>
  </div>


  <!-- ════════════════════════════════
       SECTION: DANGER ZONE
  ════════════════════════════════ -->

  <div class="card" style="animation-delay:0.1s">
    <div class="danger-header">
      <div class="danger-title">Reset Library Data</div>
      <div class="danger-sub">Permanently delete library records. These actions cannot be undone and will affect all users.</div>
    </div>

    <div class="danger-note">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#fbbf24" stroke-width="2" style="flex-shrink:0;margin-top:1px">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
      </svg>
      Delete in the order shown below (1 → 3) to avoid foreign key conflicts.
    </div>

    <div class="delete-list">

      <div class="delete-item">
        <div class="delete-item-left">
          <div class="delete-order">1</div>
          <div><div class="delete-label">All reservation records</div></div>
        </div>
        <a href="#" class="delete-btn deleteLink" data-action="reservations">Delete</a>
      </div>

      <div class="delete-item">
        <div class="delete-item-left">
          <div class="delete-order">2</div>
          <div><div class="delete-label">All borrow records</div></div>
        </div>
        <a href="#" class="delete-btn deleteLink" data-action="borrows">Delete</a>
      </div>

      <div class="delete-item">
        <div class="delete-item-left">
          <div class="delete-order">3</div>
          <div><div class="delete-label">All student records</div></div>
        </div>
        <a href="#" class="delete-btn deleteLink" data-action="students">Delete</a>
      </div>

      
      

    </div>
  </div>

</div><!-- end page-body -->


<!-- ══════════════════════════════
     MODAL: Danger Zone Password
════════════════════════════════ -->
<div class="modal-backdrop" id="passwordModal">
  <div class="modal">
    <div class="modal-icon red">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#f87171" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
    </div>
    <div class="modal-title">Admin Confirmation</div>
    <div class="modal-sub">You are about to delete: <span id="modalActionLabel">—</span></div>
    <form id="adminDeleteForm">
      <input type="hidden" id="deleteAction" />
      <div class="modal-field">
        <label>Admin Password</label>
        <input type="password" id="adminPassword" class="danger" placeholder="Enter your password" autocomplete="off" required />
      </div>
      <div class="modal-actions">
        <button type="button" class="modal-btn cancel" id="cancelDeleteBtn">Cancel</button>
        <button type="submit" class="modal-btn confirm-red">Confirm Delete</button>
      </div>
    </form>
  </div>
</div>


<!-- ══════════════════════════════
     MODAL: Reset Password Confirm
════════════════════════════════ -->
<div class="modal-backdrop" id="resetConfirmModal">
  <div class="modal">
    <div class="modal-icon accent">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#22d3ee" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
      </svg>
    </div>
    <div class="modal-title">Reset Password?</div>
    <div class="modal-sub">This will reset the password for Admin ID <span id="confirmLibrarianId" style="color:var(--accent);font-weight:600">—</span>. This cannot be undone.</div>
    <div class="modal-actions">
      <button type="button" class="modal-btn cancel" id="cancelResetBtn">Cancel</button>
      <button type="button" class="modal-btn confirm-accent" id="proceedResetBtn">Yes, Reset</button>
    </div>
  </div>
</div>


<!-- ── TOAST ── -->
<div class="toast" id="toast"></div>


<script>
  /* ─────────────────────────────────────────
     TOAST HELPER
  ───────────────────────────────────────── */
  const toast = document.getElementById('toast');
  function showToast(msg, type = '') {
    toast.textContent = msg;
    toast.className = 'toast show ' + type;
    setTimeout(() => { toast.className = 'toast'; }, 3500);
  }

  /* ─────────────────────────────────────────
     MODAL HELPERS
  ───────────────────────────────────────── */
  function openModal(id)  { document.getElementById(id).classList.add('open'); }
  function closeModal(id) { document.getElementById(id).classList.remove('open'); }

  document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
    backdrop.addEventListener('click', function(e) {
      if (e.target === this) this.classList.remove('open');
    });
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-backdrop.open').forEach(m => m.classList.remove('open'));
    }
  });

  /* ─────────────────────────────────────────
     RESET LIBRARIAN PASSWORD
  ───────────────────────────────────────── */
  document.getElementById('clearResetBtn').addEventListener('click', () => {
    document.getElementById('resetLibrarianId').value = '';
    document.getElementById('resetNewPassword').value = '';
  });

  document.getElementById('submitResetBtn').addEventListener('click', () => {
    const id  = document.getElementById('resetLibrarianId').value.trim();
    const pwd = document.getElementById('resetNewPassword').value;

    if (!id) {
      showToast('Please enter a Librarian ID.', 'error');
      return;
    }
    if (!pwd || pwd.length < 6) {
      showToast('Password must be at least 6 characters.', 'error');
      return;
    }

    document.getElementById('confirmLibrarianId').textContent = id;
    openModal('resetConfirmModal');
  });

  document.getElementById('cancelResetBtn').addEventListener('click', () => closeModal('resetConfirmModal'));

  document.getElementById('proceedResetBtn').addEventListener('click', async () => {
    closeModal('resetConfirmModal');
    const id  = document.getElementById('resetLibrarianId').value.trim();
    const pwd = document.getElementById('resetNewPassword').value;

    try {
      const res  = await fetch(`/librarian/reset-password/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ newPassword: pwd }),
      });
      const data = await res.json();
      if (data.success) {
        document.getElementById('resetLibrarianId').value = '';
        document.getElementById('resetNewPassword').value = '';
        showToast('Password reset successfully.', 'success');
      } else {
        showToast(data.message || 'Failed to reset password.', 'error');
      }
    } catch (err) {
      showToast('Server error. Please try again.', 'error');
    }
  });

  /* ─────────────────────────────────────────
     DANGER ZONE — DELETE MODAL
  ───────────────────────────────────────── */
  const actionNames = {
    reservations:  'all reservation records',
    borrows:       'all borrow records',
    students:      'all student records',
    'book-copies': 'all book copies',
    books:         'all book records',
  };

  document.querySelectorAll('.deleteLink').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const action = this.dataset.action;
      document.getElementById('deleteAction').value           = action;
      document.getElementById('modalActionLabel').textContent = actionNames[action] || action;
      document.getElementById('adminPassword').value          = '';
      openModal('passwordModal');
    });
  });

  document.getElementById('cancelDeleteBtn').addEventListener('click', () => closeModal('passwordModal'));

  document.getElementById('adminDeleteForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const action   = document.getElementById('deleteAction').value;
    const password = document.getElementById('adminPassword').value;

    try {
      const res  = await fetch('/librarian/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, password }),
      });
      const data = await res.json();
      closeModal('passwordModal');
      if (data.success) {
        showToast('Records deleted successfully.', 'success');
      } else {
        showToast(data.message || 'Failed to delete records.', 'error');
      }
    } catch (err) {
      closeModal('passwordModal');
      showToast('Server error. Please try again.', 'error');
    }
  });
</script>
<script src="/librarianPagesScripts/adminHomePage.js"></script>

</body>
</html>

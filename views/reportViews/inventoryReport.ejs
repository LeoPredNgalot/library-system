<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inventory Report — Voctech Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="/styles/togglebutton/theme.css" />
  <link rel="stylesheet" href="/styles/inventoryPagesStyleFolder/inventory.css" />
  <script>
    (function(){
      if(localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    })();
    window.addEventListener('storage', function(e){
      if(e.key === 'theme'){
        e.newValue === 'dark'
          ? document.documentElement.classList.add('dark')
          : document.documentElement.classList.remove('dark');
      }
    });
  </script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script>
    if (new URLSearchParams(window.location.search).get('embed') === 'true') {
      document.documentElement.classList.add('embedded');
    }
  </script>
</head>
<body>

<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <span class="topbar-title">Inventory Report</span>
    </div>
    <div class="topbar-actions">
      <button class="btn-export" onclick="printReport()">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
        </svg>
        Print
      </button>
      <button class="btn-export btn-pdf" onclick="downloadPDF()">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Download PDF
      </button>
    </div>
  </div>

  <div class="page-body" id="printArea">

    <!-- Print header (only shows when printing) -->
    <div class="print-header">
      <div class="print-logo">Voctech Library</div>
      <div class="print-title">Inventory Report</div>
      <div class="print-meta">Generated: <%= new Date().toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %></div>
      <% if (filters.dateRange === 'this_week') { %>
        <div class="print-meta">Filter: This Week</div>
      <% } else if (filters.dateRange === 'this_month') { %>
        <div class="print-meta">Filter: This Month</div>
      <% } else if (filters.dateRange === 'custom') { %>
        <div class="print-meta">Date Range: <%= filters.dateFrom || '—' %> to <%= filters.dateTo || '—' %></div>
      <% } %>
      <% if (filters.genre) { %><div class="print-meta">Genre: <%= filters.genre %></div><% } %>
      <% if (filters.search) { %><div class="print-meta">Search: "<%= filters.search %>"</div><% } %>
    </div>

    <!-- Summary Cards -->
    <div class="summary-grid">
      <div class="stat-card"><div class="stat-label">Total Books</div><div class="stat-value accent"><%= summary.total_titles %></div></div>
      <div class="stat-card"><div class="stat-label">Total Copies</div><div class="stat-value"><%= summary.total_copies %></div></div>
      <div class="stat-card"><div class="stat-label">Available</div><div class="stat-value green"><%= summary.total_available %></div></div>
      <div class="stat-card"><div class="stat-label">Borrowed</div><div class="stat-value yellow"><%= summary.total_borrowed %></div></div>
      <div class="stat-card"><div class="stat-label">Lost</div><div class="stat-value red"><%= summary.total_lost %></div></div>
      <div class="stat-card"><div class="stat-label">Damaged</div><div class="stat-value orange"><%= summary.total_damaged %></div></div>
    </div>

    <!-- Table Card -->
    <div class="table-card">

      <!-- Filter bar -->
      <div class="table-filter no-print">
        <form class="filter-form" method="GET" action="/reports/inventory" id="filterForm">
          <input type="hidden" name="embed" value="true" />
          <!-- Search -->
          <div class="filter-search">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
            <input type="text" name="search" class="filter-input" placeholder="Search by title, author, or ISBN…" value="<%= filters.search %>" autocomplete="off" />
          </div>

          <!-- Genre -->
          <div class="select-wrap">
            <select name="genre" class="filter-select">
              <option value="">All Genres</option>
              <% genres.forEach(item => { %>
                <option value="<%= item %>" <%= filters.genre === item ? 'selected' : '' %>><%= item %></option>
              <% }) %>
            </select>
            <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>

          <!-- Date range quick buttons -->
          <div class="date-range-group">
            <button type="button" class="date-range-btn <%= filters.dateRange === 'this_week'  ? 'active' : '' %>" onclick="setDateRange('this_week')" title="Books added this week">This Week</button>
            <button type="button" class="date-range-btn <%= filters.dateRange === 'this_month' ? 'active' : '' %>" onclick="setDateRange('this_month')">This Month</button>
            <button type="button" class="date-range-btn <%= filters.dateRange === 'custom'     ? 'active' : '' %>" onclick="setDateRange('custom')">Custom Range</button>
          </div>

          <!-- Hidden date range value -->
          <input type="hidden" name="dateRange" id="dateRangeInput" value="<%= filters.dateRange %>" />

          <!-- Custom date pickers (shown only when custom is selected) -->
          <div class="custom-range-wrap" id="customRangeWrap">
            <input type="date" name="dateFrom" class="filter-input date-input" value="<%= filters.dateFrom %>" placeholder="From" />
            <span class="date-sep">—</span>
            <input type="date" name="dateTo"   class="filter-input date-input" value="<%= filters.dateTo %>"   placeholder="To"   />
          </div>

          <a href="/reports/inventory?embed=true" class="btn-clear">Clear</a>
          <!-- type="button" prevents premature form submit; applyFilters() sets dateRange first -->
          <button type="button" class="btn-apply" onclick="applyFilters()">Apply</button>
        </form>

        <!-- Active filter badge -->
        <% if (filters.search || filters.genre || filters.dateRange) { %>
          <div class="filter-badge">
            Showing <strong><%= pagination.totalBooks %></strong> books
            <% if (filters.dateRange === 'this_week')  { %> · <strong>This Week</strong><% } %>
            <% if (filters.dateRange === 'this_month') { %> · <strong>This Month</strong><% } %>
            <% if (filters.dateRange === 'custom' && (filters.dateFrom || filters.dateTo)) { %>
              · <strong><%= filters.dateFrom || '…' %></strong> to <strong><%= filters.dateTo || '…' %></strong>
            <% } %>
            <% if (filters.genre)  { %> · Genre: <strong><%= filters.genre %></strong><% } %>
            <% if (filters.search) { %> · "<strong><%= filters.search %></strong>"<% } %>
          </div>
        <% } %>
      </div>

      <!-- Table -->
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>ID</th><th>Title</th><th>Author</th><th>Genre</th><th>Year</th>
              <th>Total</th><th>Available</th><th>Borrowed</th><th>Lost</th><th>Damaged</th>
              <th>Location</th><th>Publisher</th><th>ISBN</th><th>Date Added</th><th class="no-print">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (books.length === 0) { %>
              <tr class="no-data"><td colspan="15">No books found.</td></tr>
            <% } %>
            <% books.forEach(book => { %>
              <tr>
                <td><span class="cell-id"><%= book.id %></span></td>
                <td><span class="cell-title"><%= book.title %></span></td>
                <td><%= book.author %></td>
                <td><%= book.genre || '—' %></td>
                <td><%= book.year_published || '—' %></td>
                <td><span class="count-badge badge-total"><%= book.total_copies %></span></td>
                <td><span class="count-badge <%= book.available_count > 0 ? 'badge-avail' : 'badge-zero' %>"><%= book.available_count %></span></td>
                <td><span class="count-badge <%= book.borrowed_count  > 0 ? 'badge-borrowed' : 'badge-zero' %>"><%= book.borrowed_count %></span></td>
                <td><span class="count-badge <%= book.lost_count      > 0 ? 'badge-lost'     : 'badge-zero' %>"><%= book.lost_count %></span></td>
                <td><span class="count-badge <%= book.damaged_count   > 0 ? 'badge-damaged'  : 'badge-zero' %>"><%= book.damaged_count %></span></td>
                <td><%= book.book_location || '—' %></td>
                <td><%= book.publisher     || '—' %></td>
                <td><span class="cell-mono"><%= book.isbn || '—' %></span></td>
                <td><span class="cell-mono"><%= book.date_added ? new Date(book.date_added).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : '—' %></span></td>
                <td class="no-print">
                  <button class="btn-view view-book-btn" data-id="<%= book.id %>">
                    <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    View
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="pagination no-print">
        <p class="page-info">
          Page <span><%= pagination.page %></span> of <span><%= pagination.totalPages %></span>
          &nbsp;·&nbsp; <span><%= pagination.totalBooks %></span> books total
        </p>
        <div class="pg-btns">
          <% const baseUrl = `/reports/inventory?search=${encodeURIComponent(filters.search)}&genre=${encodeURIComponent(filters.genre)}&dateRange=${encodeURIComponent(filters.dateRange)}&dateFrom=${encodeURIComponent(filters.dateFrom)}&dateTo=${encodeURIComponent(filters.dateTo)}&embed=true`; %>
          <% if (pagination.hasPrev) { %>
            <a class="pg-btn" href="<%= baseUrl %>&page=<%= pagination.prevPage %>">
              <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg> Prev
            </a>
          <% } else { %>
            <span class="pg-btn disabled"><svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg> Prev</span>
          <% } %>
          <% if (pagination.hasNext) { %>
            <a class="pg-btn" href="<%= baseUrl %>&page=<%= pagination.nextPage %>">
              Next <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          <% } else { %>
            <span class="pg-btn disabled">Next <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></span>
          <% } %>
        </div>
      </div>

    </div>
    <div class="page-body-end no-print"></div>
  </div>
</div>

<!-- ── BOOK VIEW MODAL ── -->
<div class="modal-overlay hidden" id="bookModal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-icon">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--accent)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      </div>
      <div>
        <div class="modal-head-title">Book Details</div>
        <div class="modal-head-sub" id="modalSub">Loading…</div>
      </div>
      <button class="btn-close" id="closeModal">
        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="book-header" id="modalBookHeader">
      <div class="book-cover" id="modalCover"><div class="skeleton" style="width:100%;height:100%;"></div></div>
      <div style="flex:1;">
        <div class="book-title"  id="modalTitle"><div class="skeleton" style="height:18px;width:80%;margin-bottom:8px;"></div></div>
        <div class="book-author" id="modalAuthor"><div class="skeleton" style="height:14px;width:50%;"></div></div>
      </div>
    </div>
    <div class="copy-strip" id="modalCopyStrip">
      <% ['Total','Available','Borrowed','Lost','Damaged'].forEach(l => { %>
        <div class="copy-stat"><div class="copy-stat-val skeleton" style="height:22px;width:30px;margin:0 auto;"></div><div class="copy-stat-lbl"><%= l %></div></div>
      <% }) %>
    </div>
    <div class="detail-grid" id="modalDetailGrid">
      <div class="detail-item"><div class="detail-label">Genre</div><div class="detail-value" id="md-genre">—</div></div>
      <div class="detail-item"><div class="detail-label">Year Published</div><div class="detail-value" id="md-year">—</div></div>
      <div class="detail-item"><div class="detail-label">Publisher</div><div class="detail-value" id="md-publisher">—</div></div>
      <div class="detail-item"><div class="detail-label">Location</div><div class="detail-value" id="md-location">—</div></div>
      <div class="detail-item"><div class="detail-label">ISBN</div><div class="detail-value mono" id="md-isbn">—</div></div>
      <div class="detail-item"><div class="detail-label">Date Added</div><div class="detail-value mono" id="md-date">—</div></div>
    </div>
    <div class="copies-head">Book Copies</div>
    <ul class="copies-list" id="modalCopiesList">
      <li style="justify-content:center;color:var(--text-muted);font-size:13px;">Loading copies…</li>
    </ul>
    <div class="modal-footer">
      <button class="btn-secondary" id="closeModalFooter">Close</button>
    </div>
  </div>
</div>


<script src="/reportPageScript/reportscript.js"></script>

</body>
</html>
